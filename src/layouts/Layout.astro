---
import "@/styles/starwind.css";
import "../styles/global.css";

interface Props {
	title?: string;
}

const { title = "Idiomas del Futuro" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<base href={import.meta.env.BASE_URL} />
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={`/idiomas-futuro/favicon.svg`} />
		<link rel="icon" href={`/idiomas-futuro/favicon.ico`} />
		<meta name="generator" content={Astro.generator} />
		<script is:inline>
			if (sessionStorage.getItem("idf-hero-seen")) {
				document.documentElement.classList.add("idf-hero-seen");
			} else {
				sessionStorage.setItem("idf-hero-seen", "1");
			}
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link
			href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Display&family=Karla:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body class="bg-idf-cream text-idf-ink">
		<slot />
		<script is:inline>
			(function () {
				if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
				var targets = document.querySelectorAll("body > div > section:not(:first-of-type), body > div > footer");
				if (!targets.length) return;
				var observer = new IntersectionObserver(
					function (entries) {
						entries.forEach(function (entry) {
							if (entry.isIntersecting) {
								entry.target.classList.add("is-visible");
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
				);
				targets.forEach(function (el) {
					el.classList.add("idf-reveal");
					observer.observe(el);
				});
			})();
		</script>
	</body>
</html>
