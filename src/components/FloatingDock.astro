---
import { CalendarDays, GraduationCap, BarChart3 } from "@lucide/astro";
import { waHref } from "@/config/whatsapp";

const navLinks = [
	{ href: `/calendarios`, label: "Próximos inicios", icon: CalendarDays },
	{ href: `/profesores`, label: "Profesores", icon: GraduationCap },
	{ href: `/metodo`, label: "Método", icon: BarChart3 },
];

const itemClass =
	"flex items-center gap-2 whitespace-nowrap rounded-full px-3.5 py-2.5 text-[14px] text-white/72 no-underline transition-all duration-300 hover:bg-white/10 hover:text-white md:px-5 md:py-3";
const activeItemClass = "bg-white/12 text-white";
const iconClass = "size-[22px] shrink-0 md:size-4.5";

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<div class="pointer-events-none fixed bottom-[22px] left-1/2 z-120 flex -translate-x-1/2 justify-center max-[720px]:right-3 max-[720px]:left-3 max-[720px]:translate-x-0 md:bottom-7">
	<nav
		class="pointer-events-auto flex items-center gap-1 rounded-full border border-white/12 bg-idf-navy/82 p-1.5 shadow-[0_22px_54px_rgba(7,26,15,0.42),inset_0_1px_0_rgba(255,255,255,0.14)] backdrop-blur-2xl backdrop-saturate-150 max-[720px]:w-full max-[720px]:justify-between max-[720px]:gap-2 md:gap-1.5 md:p-2"
	>
		<a
			href={``}
			title="Idiomas del Futuro"
			class="relative flex size-10 shrink-0 items-center justify-center rounded-full bg-idf-lime transition-all duration-300 hover:bg-white md:size-11"
		>
			<span class="block h-4 w-4 rounded-full border-2 border-idf-navy md:h-4.5 md:w-4.5"></span>
			<span class="absolute top-2 right-2 h-2 w-2 rotate-45 bg-idf-navy md:top-2.5 md:right-2.5 md:h-2.5 md:w-2.5"></span>
		</a>

		{navLinks.map((link) => (
			<a
				href={link.href}
				aria-current={currentPath === link.href ? "page" : undefined}
				class={`${itemClass} ${currentPath === link.href ? activeItemClass : ""}`}
			>
				<link.icon class={iconClass} stroke-width={1.7} />
				<span class="hidden md:inline">{link.label}</span>
			</a>
		))}

		<a
			href={waHref}
			target="_blank"
			rel="noopener noreferrer"
			class="flex items-center gap-2 whitespace-nowrap rounded-full bg-white px-3.5 py-2.5 text-[14px] font-medium text-idf-navy no-underline transition-all duration-300 hover:bg-idf-lime md:px-5 md:py-3"
		>
			<svg class={iconClass} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path
					d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.97L2 22l5.25-1.38c1.45.79 3.09 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm5.8 14.02c-.24.68-1.4 1.3-1.93 1.35-.53.05-1.02.24-3.44-.71-2.9-1.14-4.72-4.14-4.86-4.33-.14-.19-1.15-1.53-1.15-2.92 0-1.39.73-2.07.99-2.36.26-.29.56-.36.75-.36.19 0 .38 0 .55.01.17.01.41-.07.64.49.24.58.81 1.97.88 2.11.07.14.12.31.02.5-.1.19-.15.31-.29.48-.14.17-.3.38-.43.51-.14.14-.29.29-.12.58.17.29.75 1.24 1.61 2.01 1.11.99 2.04 1.3 2.33 1.44.29.14.46.12.63-.07.17-.19.72-.84.91-1.13.19-.29.38-.24.65-.14.26.1 1.66.78 1.95.92.29.14.48.22.55.34.07.13.07.75-.17 1.43z"
				></path>
			</svg>
			<span class="hidden md:inline">Reservar</span>
		</a>
	</nav>
</div>
