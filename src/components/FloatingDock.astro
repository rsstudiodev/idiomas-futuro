---
import { CalendarDays, GraduationCap, BarChart3 } from "@lucide/astro";

const waHref = "https://wa.me/523311223344?text=%C2%A1Hola!%20Quiero%20reservar%20un%20lugar%20en%20Idiomas%20del%20Futuro";

const navLinks = [
	{ href: `/calendarios`, label: "Próximos inicios", icon: CalendarDays },
	{ href: `/profesores`, label: "Profesores", icon: GraduationCap },
	{ href: `/metodo`, label: "Método", icon: BarChart3 },
];

const itemClass =
	"flex items-center gap-2 whitespace-nowrap rounded-2xl px-3.5 py-2.5 font-sans text-[15px] text-idf-cream no-underline transition-all duration-300 hover:bg-idf-cream/16 md:rounded-[19px] md:px-5.5 md:py-3.75 md:text-base";
const iconClass = "size-[25px] shrink-0 md:size-5.5";
---

<div class="pointer-events-none fixed bottom-[22px] left-1/2 z-120 flex -translate-x-1/2 justify-center max-[720px]:right-3 max-[720px]:left-3 max-[720px]:translate-x-0 md:bottom-7">
	<nav
		class="pointer-events-auto flex items-center gap-1 rounded-[22px] border border-idf-cream/22 bg-idf-navy/70 p-1.5 shadow-[0_22px_54px_rgba(20,52,92,0.34),inset_0_1px_0_rgba(255,255,255,0.16)] backdrop-blur-2xl backdrop-saturate-150 max-[720px]:w-full max-[720px]:justify-between max-[720px]:gap-2.5 md:gap-1.5 md:rounded-[26px] md:p-2.75"
	>
		<a
			href={``}
			title="Idiomas del Futuro"
			class="relative flex size-11 shrink-0 items-center justify-center rounded-2xl border-2 border-idf-navy bg-idf-cream transition-all duration-300 hover:bg-white md:size-13.5 md:rounded-[19px]"
		>
			<span class="block h-4.5 w-4.5 rounded-full border-2 border-idf-navy md:h-5.5 md:w-5.5"></span>
			<span class="absolute top-2 right-2 h-2.5 w-2.5 rotate-45 bg-idf-amber md:top-2.5 md:right-2.5 md:h-3 md:w-3"></span>
		</a>

		{navLinks.map((link) => (
			<a href={link.href} class={itemClass}>
				<link.icon class={iconClass} stroke-width={1.7} />
				<span class="hidden md:inline">{link.label}</span>
			</a>
		))}

		<a
			href={waHref}
			target="_blank"
			rel="noopener noreferrer"
			class="flex items-center gap-2 whitespace-nowrap rounded-2xl bg-idf-cream px-3.5 py-2.5 font-sans text-[15px] font-semibold text-idf-navy no-underline transition-all duration-300 hover:bg-white md:rounded-[19px] md:px-5.5 md:py-3.75 md:text-base"
		>
			<svg class={iconClass} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path
					d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.97L2 22l5.25-1.38c1.45.79 3.09 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm5.8 14.02c-.24.68-1.4 1.3-1.93 1.35-.53.05-1.02.24-3.44-.71-2.9-1.14-4.72-4.14-4.86-4.33-.14-.19-1.15-1.53-1.15-2.92 0-1.39.73-2.07.99-2.36.26-.29.56-.36.75-.36.19 0 .38 0 .55.01.17.01.41-.07.64.49.24.58.81 1.97.88 2.11.07.14.12.31.02.5-.1.19-.15.31-.29.48-.14.17-.3.38-.43.51-.14.14-.29.29-.12.58.17.29.75 1.24 1.61 2.01 1.11.99 2.04 1.3 2.33 1.44.29.14.46.12.63-.07.17-.19.72-.84.91-1.13.19-.29.38-.24.65-.14.26.1 1.66.78 1.95.92.29.14.48.22.55.34.07.13.07.75-.17 1.43z"
				></path>
			</svg>
			<span class="hidden md:inline">Reservar</span>
		</a>
	</nav>
</div>
