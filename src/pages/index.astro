---
import Layout from "@/layouts/Layout.astro";
import FloatingDock from "@/components/FloatingDock.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { waHref } from "@/config/whatsapp";
import { Check, GraduationCap, Languages, Layers, Compass, Landmark, Globe } from "@lucide/astro";
const waPromo = waHref;
const waVisita = waHref;

const services = [
	{
		tag: "Idioma",
		title: "Inglés general",
		desc: "Del A1 al C1 en seis niveles de cuatro meses. Dos sesiones por semana.",
		price: "$1,290",
		unit: "/mes",
		href: `/calendarios#ingles`,
	},
	{
		tag: "Idioma",
		title: "Portugués de Brasil",
		desc: "Pronunciación carioca, negocios y trámites. Niveles A1 a B2.",
		price: "$1,190",
		unit: "/mes",
		href: `/calendarios#portugues`,
	},
	{
		tag: "Idioma",
		title: "Chino mandarín",
		desc: "Tonos, pinyin y caracteres con apoyo de escritura guiada. HSK 1 a 4.",
		price: "$1,490",
		unit: "/mes",
		href: `/calendarios#chino`,
	},
];

const extras = [
	{
		tag: "Práctica",
		title: "Club de conversación",
		desc: "Sesiones abiertas de 90 minutos, sábados. Gratis para alumnos inscritos.",
		price: "$180",
		unit: "/ sesión suelta",
	},
	{
		tag: "Certificación",
		title: "Preparación de exámenes",
		desc: "Simulacros cronometrados y retroalimentación individual. 8 semanas.",
		price: "$3,600",
		unit: "/ curso",
	},
	{
		tag: "Empresas",
		title: "Cursos in-company",
		desc: "Vamos a tu oficina o en línea, con reportes mensuales de avance.",
		price: "Cotización",
		unit: "a medida",
	},
];

const startDates = [
	{ title: "Inglés A1 · Lu-Mi 19:00", date: "Inicia 3 de septiembre", seats: "6 lugares", highlight: true },
	{ title: "Portugués A2 · Sáb 10:00", date: "Inicia 12 de septiembre", seats: "4 lugares", highlight: false },
	{ title: "Chino HSK 1 · Ma-Ju 18:00", date: "Inicia 22 de septiembre", seats: "8 lugares", highlight: false },
];

const facilities = [
	{ img: "https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1200&q=80", alt: "Salón principal", big: true },
	{ img: "https://images.unsplash.com/photo-1524758631624-e2822e304c36?auto=format&fit=crop&w=1200&q=80", alt: "Sala de estudio", wide: true },
	{ img: "https://images.unsplash.com/photo-1521737604893-d14cc237f11d?auto=format&fit=crop&w=900&q=80", alt: "Club de conversación" },
	{ img: "https://images.unsplash.com/photo-1580582932707-520aed937b7b?auto=format&fit=crop&w=900&q=80", alt: "Biblioteca de préstamo" },
];

const pricing = [
	{ title: "Mensual", desc: "2 clases por semana, 8 sesiones al mes.", price: "$1,290", featured: false },
	{ title: "Trimestral", desc: "Un nivel completo, con examen de certificación interna.", price: "$3,290", oldPrice: "$3,870", featured: true },
	{ title: "Clases privadas", desc: "Uno a uno, presencial o en línea, horario abierto.", price: "$420", unit: "/hora", featured: false },
];

const teasers = [
	{
		href: `/metodo`,
		img: "https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1200&q=80",
		alt: "Clase en curso",
		tag: "Método",
		title: "70% del tiempo hablando, 30% explicando",
		desc: "Cómo estructuramos cada sesión y por qué avanzas más rápido. →",
	},
	{
		href: `/profesores`,
		img: "https://images.unsplash.com/photo-1524178232363-1fb2b075b655?auto=format&fit=crop&w=1200&q=80",
		alt: "Profesora con alumnos",
		tag: "Equipo",
		title: "Cuatro profesores, cuatro acentos reales",
		desc: "Conoce a quién vas a tener enfrente cada semana. →",
	},
];

const posts = [
	{ img: "https://images.unsplash.com/photo-1543269865-cbf427effbad?auto=format&fit=crop&w=800&q=80", caption: "Nuestro grupo de B1 cerró el nivel con un debate de 40 minutos ☕ 214 ♥" },
	{ img: "https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=800&q=80", caption: "Tres palabras en portugués que todos confundimos · 158 ♥" },
	{ img: "https://images.unsplash.com/photo-1503676260728-1c00da094a0b?auto=format&fit=crop&w=800&q=80", caption: "Los 4 tonos del mandarín explicados con canciones · 402 ♥" },
	{ img: "https://images.unsplash.com/photo-1571260899304-425eee4c7efc?auto=format&fit=crop&w=800&q=80", caption: "Club de lectura del sábado: cuentos cortos en inglés · 96 ♥" },
	{ img: "https://images.unsplash.com/photo-1517048676732-d65bc937f952?auto=format&fit=crop&w=800&q=80", caption: "Curso in-company en una agencia de Zapopan · 73 ♥" },
	{ img: "https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&w=800&q=80", caption: "Abrimos dos grupos nuevos de A1 por la mañana · 121 ♥" },
];

const reviews = [
	{ name: "Andrea Villalobos", text: "Llevaba años diciendo que iba a retomar el inglés. Aquí hablé desde la primera clase y ya no me da miedo el teléfono en el trabajo." },
	{ name: "Rodrigo Cázares", text: "Tomé portugués antes de mudarme a São Paulo. Los profes te corrigen la pronunciación sin hacerte sentir mal." },
	{ name: "Marisol Fregoso", text: "Mi hija entró a chino con 14 años y ya escribe sus primeros caracteres. El grupo pequeño hace toda la diferencia." },
	{ name: "Diego Palomera", text: "Contratamos el curso in-company para seis personas del equipo. Reportes claros cada mes y cero faltas." },
	{ name: "Paulina Iñiguez", text: "El club de conversación de los sábados vale la inscripción por sí solo." },
	{ name: "Ana Karen Ruvalcaba", text: "Pasé el examen de certificación en el primer intento después del curso de preparación." },
];
const marqueeReviews = [...reviews, ...reviews];

const heroChecks = ["Grupos de máximo 8", "Profesores certificados", "Horarios flexibles"];

const partners = [
	{ name: "CELPE Norte", icon: Layers },
	{ name: "Instituto Yuán", icon: Compass },
	{ name: "Consorcio Lusófono", icon: Landmark },
	{ name: "Red ANLE", icon: Globe },
];

const methodStats = [
	{ label: "Hablas", value: "70%" },
	{ label: "Por grupo", value: "8 máx." },
	{ label: "Sesión", value: "120 min" },
	{ label: "Reportes", value: "4 al año" },
];

const methodRows = [
	{ tag: "Conversación", desc: "Arrancas hablando en pareja sobre algo real, antes de abrir cualquier libro." },
	{ tag: "Contexto", desc: "Audios, notas de prensa y chats de trabajo reales: primero entiendes, después analizas." },
	{ tag: "Gramática", desc: "La regla llega cuando ya la necesitas para decir algo que quieres decir." },
];
---

<Layout title="Idiomas del Futuro — Escuela de idiomas">
	<div class="w-full overflow-x-hidden bg-idf-cream pb-24 text-idf-ink">
		<section class="relative flex w-full flex-col items-center overflow-hidden rounded-b-[40px] bg-idf-navy px-6 pt-[132px] pb-[220px] max-[640px]:pt-[96px] max-[640px]:pb-[160px]">
			<div class="absolute inset-0 bg-[radial-gradient(120%_100%_at_50%_-10%,#164a29_0%,#0f351e_38%,#0a2415_70%,#071a0f_100%)]"></div>
			<div class="idf-stars absolute inset-0 opacity-70 [mask-image:linear-gradient(to_bottom,rgba(0,0,0,.9),transparent_78%)]"></div>

			<div class="pointer-events-none fixed inset-0 z-50 flex items-center justify-center" aria-hidden="true">
				<div
					id="hero-logo-fly"
					class="hero-motion relative flex h-[40vmin] w-[40vmin] items-center justify-center rounded-[28%] bg-idf-lime opacity-0 md:h-[30vmin] md:w-[30vmin] [animation:idf-hero-logo-intro_1.4s_ease-in-out_forwards]"
				>
					<span class="block h-[38%] w-[38%] rounded-full border-4 border-idf-navy"></span>
					<span class="absolute top-[16%] right-[16%] h-[19%] w-[19%] rotate-45 bg-idf-navy"></span>
				</div>
			</div>

			<div class="relative flex w-full max-w-3xl flex-col items-center gap-7 text-center">
				<div class="hero-motion flex flex-col items-center gap-4 opacity-0 [animation:idf-hero-logo-settle_0.5s_ease-out_1.2s_forwards]">
					<div id="hero-logo-target" class="relative flex h-14 w-14 items-center justify-center rounded-[18px] bg-idf-lime">
						<span class="block h-5.5 w-5.5 rounded-full border-[3px] border-idf-navy"></span>
						<span class="absolute top-2.5 right-2.5 h-2.5 w-2.5 rotate-45 bg-idf-navy"></span>
					</div>
				</div>

				<p class="hero-motion m-0 flex items-center gap-2.5 text-[13px] text-white/60 opacity-0 [animation:idf-hero-reveal_0.6s_ease-out_1.4s_forwards]">
					<span class="inline-block size-1.5 shrink-0 rounded-full bg-idf-lime"></span>
					Agosto: inscripción sin costo y examen de nivel gratis
				</p>

				<h1 class="hero-motion m-0 text-balance font-display text-[clamp(40px,5.6vw,72px)] leading-[1.06] text-white opacity-0 [animation:idf-hero-reveal_0.7s_ease-out_1.55s_forwards]">
					Aprende el idioma<br />que abre tu futuro
				</h1>
				<p class="hero-motion m-0 max-w-[54ch] text-pretty text-[15px] leading-[1.75] text-white/62 opacity-0 [animation:idf-hero-reveal_0.7s_ease-out_1.68s_forwards]">
					Inglés, portugués y chino mandarín en grupos de máximo 8 personas. Conversas desde la primera clase, con profesores certificados y horarios que sí caben en tu semana.
				</p>

				<div class="hero-motion flex flex-wrap justify-center gap-3 opacity-0 [animation:idf-hero-reveal_0.7s_ease-out_1.8s_forwards]">
					<a href={waHref} target="_blank" rel="noopener noreferrer" class="rounded-full bg-white px-6 py-3 text-[14px] font-medium text-idf-navy no-underline transition-all duration-300 hover:-translate-y-px hover:shadow-[0_10px_26px_rgba(0,0,0,0.28)]">
						Empezar ahora
					</a>
					<a href={`/metodo`} class="rounded-full border border-white/22 px-6 py-3 text-[14px] text-white no-underline transition-colors duration-300 hover:bg-white/10">
						Conocer el método
					</a>
				</div>

				<div class="hero-motion flex flex-wrap justify-center gap-x-8 gap-y-3 opacity-0 [animation:idf-hero-reveal_0.7s_ease-out_1.92s_forwards]">
					{heroChecks.map((c) => (
						<span class="flex items-center gap-2 text-[13px] text-white/70">
							<Check class="size-4 text-idf-lime" stroke-width={2.4} />
							{c}
						</span>
					))}
				</div>
			</div>

			<!-- Tarjetas flotantes -->
			<div class="relative mt-20 w-full max-w-5xl max-[900px]:mt-14" aria-hidden="true">
				<div class="grid grid-cols-3 items-end gap-6 max-[900px]:grid-cols-1 max-[900px]:gap-4">
					<div class="flex flex-col gap-5 max-[900px]:contents">
						<div class="animate-idf-float rounded-[20px] bg-white p-4 shadow-[0_18px_40px_rgba(0,0,0,0.22)] max-[900px]:rotate-0 -rotate-3">
							<div class="flex items-center gap-3">
								<span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-idf-lime/30">
									<GraduationCap class="size-4.5 text-idf-navy" stroke-width={1.9} />
								</span>
								<div>
									<p class="m-0 text-[10px] tracking-wide text-idf-ink/50 uppercase">Alumnos activos</p>
									<p class="m-0 text-[17px] font-semibold text-idf-navy">1,284</p>
								</div>
							</div>
						</div>
						<div class="animate-idf-float rounded-[20px] bg-white p-4 shadow-[0_18px_40px_rgba(0,0,0,0.22)] [animation-delay:1.2s] max-[900px]:rotate-0 rotate-2">
							<p class="m-0 text-[10px] tracking-wide text-idf-ink/50 uppercase">Grupo promedio</p>
							<p class="m-0 mt-1 text-[24px] font-semibold text-idf-navy">
								8 <span class="text-[12px] font-normal text-idf-ink/50">personas máx.</span>
							</p>
						</div>
					</div>

					<div class="rounded-[24px] bg-white p-5 shadow-[0_28px_60px_rgba(0,0,0,0.3)]">
						<p class="m-0 text-center text-[14px] font-semibold text-idf-navy">Próximos inicios</p>
						<p class="m-0 mt-0.5 mb-4 text-center text-[11px] text-idf-ink/50">Ciclo septiembre – diciembre 2026</p>
						<div class="flex flex-col gap-2.5">
							{startDates.map((s) => (
								<div class="flex items-center justify-between gap-3 rounded-2xl border border-idf-ink/8 px-3.5 py-3">
									<div class="min-w-0">
										<p class="m-0 truncate text-[12px] font-medium text-idf-navy">{s.title}</p>
										<p class="m-0 truncate text-[10px] text-idf-ink/50">{s.date}</p>
									</div>
									<span class:list={["shrink-0 text-[11px] font-medium", s.highlight ? "text-idf-lime-deep" : "text-idf-ink/45"]}>{s.seats}</span>
								</div>
							))}
						</div>
						<a href={`/calendarios`} class="mt-4 flex items-center justify-center rounded-full bg-idf-navy px-4 py-3 text-[12px] font-medium tracking-[0.06em] text-white no-underline uppercase">
							Ver calendario
						</a>
					</div>

					<div class="flex flex-col gap-5 max-[900px]:contents">
						<div class="animate-idf-float rounded-[20px] bg-white p-4 shadow-[0_18px_40px_rgba(0,0,0,0.22)] [animation-delay:0.6s] max-[900px]:rotate-0 rotate-3">
							<div class="flex items-center gap-3">
								<span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-idf-lime/30">
									<Languages class="size-4.5 text-idf-navy" stroke-width={1.9} />
								</span>
								<div>
									<p class="m-0 text-[10px] tracking-wide text-idf-ink/50 uppercase">Idiomas</p>
									<p class="m-0 text-[17px] font-semibold text-idf-navy">3 · EN · PT · 中文</p>
								</div>
							</div>
						</div>
						<div class="animate-idf-float rounded-[20px] bg-white p-4 shadow-[0_18px_40px_rgba(0,0,0,0.22)] [animation-delay:1.8s] max-[900px]:rotate-0 -rotate-2">
							<p class="m-0 text-[10px] tracking-wide text-idf-ink/50 uppercase">Satisfacción</p>
							<div class="mt-1 flex items-baseline gap-2">
								<p class="m-0 text-[24px] font-semibold text-idf-navy">4.9</p>
								<span class="text-[12px] text-idf-ink/45">de 214 reseñas</span>
							</div>
						</div>
					</div>
				</div>
			</div>

			<script is:inline>
				(function () {
					var flyer = document.getElementById("hero-logo-fly");
					var target = document.getElementById("hero-logo-target");
					if (!flyer || !target) return;
					if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
						flyer.style.display = "none";
						return;
					}
					var fr = flyer.getBoundingClientRect();
					var tr = target.getBoundingClientRect();
					var dx = tr.left + tr.width / 2 - (fr.left + fr.width / 2);
					var dy = tr.top + tr.height / 2 - (fr.top + fr.height / 2);
					var scale = tr.width / fr.width;
					flyer.style.setProperty("--idf-hero-tx", dx + "px");
					flyer.style.setProperty("--idf-hero-ty", dy + "px");
					flyer.style.setProperty("--idf-hero-ts", String(scale));
				})();
			</script>
		</section>

		<section class="flex w-full flex-col items-center gap-8 px-6 py-20">
			<span class="text-[11px] font-medium tracking-[0.16em] text-idf-ink/40 uppercase">Avalados por</span>
			<div class="grid w-full max-w-[1000px] grid-cols-4 items-center justify-items-center gap-8 max-[1000px]:grid-cols-2 max-[640px]:grid-cols-1">
				{partners.map((p) => (
					<span class="flex items-center gap-2.5 text-[19px] font-medium tracking-tight text-idf-ink/30">
						<p.icon class="size-6 shrink-0" stroke-width={1.6} />
						{p.name}
					</span>
				))}
			</div>
		</section>

		<section id="servicios" class="flex w-full scroll-mt-24 flex-col items-center px-6 py-28 max-[1000px]:py-20 max-[640px]:py-16">
			<div class="mx-auto mb-14 flex max-w-2xl flex-col gap-3 text-center">
				<span class="text-[12px] font-semibold text-idf-navy">Nuestros cursos</span>
				<h2 class="m-0 font-display text-[clamp(30px,3.6vw,44px)] leading-[1.12] text-idf-navy">Idiomas y programas para cada objetivo</h2>
				<p class="m-0 text-[14px] leading-[1.75] text-idf-ink/50">Todo lo que ofrecemos, con precios claros, grupos reducidos y material digital incluido.</p>
			</div>
			<div class="grid w-full max-w-6xl grid-cols-3 gap-6 max-[1000px]:grid-cols-2 max-[640px]:grid-cols-1">
				{services.map((s) => (
					<div class="flex flex-col gap-5 rounded-[24px] border border-idf-ink/8 bg-white p-6 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_14px_34px_rgba(12,43,25,0.10)]">
						<div class="flex flex-col gap-2 rounded-[18px] bg-idf-cream-alt p-5">
							<span class="text-[10px] font-semibold tracking-[0.14em] text-idf-navy/45 uppercase">{s.tag}</span>
							<h3 class="m-0 font-display text-[20px] text-idf-navy">{s.title}</h3>
							<p class="m-0 text-[13px] leading-[1.7] text-idf-ink/55">{s.desc}</p>
						</div>
						<div class="mt-auto flex items-end justify-between gap-4">
							<div>
								<span class="text-[11px] text-idf-ink/45">Desde</span>
								<p class="mt-0.5 mb-0 text-[26px] font-semibold whitespace-nowrap text-idf-navy">{s.price}<span class="text-[13px] font-normal text-idf-ink/45"> {s.unit}</span></p>
							</div>
							<a href={s.href} class="rounded-full bg-idf-navy px-4 py-2.5 text-[12px] font-medium text-white no-underline transition-colors duration-300 hover:bg-idf-blue">Inicios</a>
						</div>
					</div>
				))}
				{extras.map((e) => (
					<div class="flex flex-col gap-3 rounded-[24px] border border-idf-ink/8 bg-white p-6 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_14px_34px_rgba(12,43,25,0.10)]">
						<span class="text-[10px] font-semibold tracking-[0.14em] text-idf-navy/45 uppercase">{e.tag}</span>
						<h3 class="m-0 font-display text-[19px] text-idf-navy">{e.title}</h3>
						<p class="m-0 text-[13px] leading-[1.7] text-idf-ink/55">{e.desc}</p>
						<p class="mt-2 mb-0 text-[20px] font-semibold text-idf-navy">{e.price} <span class="text-[12px] font-normal text-idf-ink/45">{e.unit}</span></p>
					</div>
				))}
			</div>
		</section>

		<section class="flex w-full justify-center px-6 pb-28">
			<div class="w-full max-w-6xl rounded-[32px] bg-idf-cream-alt px-10 py-16 max-[640px]:px-6 max-[640px]:py-12">
				<div class="mx-auto mb-12 flex max-w-2xl flex-col gap-3 text-center">
					<span class="text-[12px] font-semibold text-idf-navy">Nuestro método</span>
					<h2 class="m-0 font-display text-[clamp(28px,3.4vw,42px)] leading-[1.12] text-idf-navy">Hablas desde la primera clase</h2>
					<p class="m-0 text-[14px] leading-[1.75] text-idf-ink/50">Grupos pequeños, práctica real y gramática solo cuando ya la necesitas.</p>
				</div>
				<div class="grid grid-cols-[1fr_1.05fr] items-center gap-12 max-[1000px]:grid-cols-1 max-[1000px]:gap-8">
					<div class="relative">
						<div class="overflow-hidden rounded-[24px]">
							<img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1200&q=80" alt="Clase en curso" class="block aspect-4/3 w-full object-cover" />
						</div>
						<div class="absolute -bottom-6 -left-6 grid grid-cols-2 gap-2.5 rounded-[20px] bg-idf-navy p-2.5 shadow-[0_20px_44px_rgba(12,43,25,0.28)] max-[640px]:hidden">
							{methodStats.map((m) => (
								<div class="rounded-[14px] bg-white px-3.5 py-3">
									<p class="m-0 text-[9px] tracking-wide text-idf-ink/45 uppercase">{m.label}</p>
									<p class="m-0 text-[18px] font-semibold text-idf-navy">{m.value}</p>
								</div>
							))}
						</div>
					</div>
					<div class="flex flex-col gap-4">
						<h3 class="m-0 font-display text-[22px] text-idf-navy">70% del tiempo hablando, 30% explicando</h3>
						{methodRows.map((r) => (
							<div class="grid grid-cols-[110px_1fr] items-start gap-4 max-[640px]:grid-cols-1 max-[640px]:gap-1.5">
								<span class="pt-0.5 text-[13px] font-medium text-idf-navy">{r.tag}</span>
								<p class="m-0 text-[13px] leading-[1.75] text-idf-ink/55">{r.desc}</p>
							</div>
						))}
						<a href={`/metodo`} class="mt-2 self-start rounded-full bg-idf-navy px-6 py-3 text-[13px] font-medium text-white no-underline transition-colors duration-300 hover:bg-idf-blue">
							Ver el método completo
						</a>
					</div>
				</div>
			</div>
		</section>

		<section id="instalaciones" class="flex w-full scroll-mt-24 flex-col items-center px-6 py-28 max-[1000px]:py-20 max-[640px]:py-16">
			<div class="mx-auto mb-14 flex max-w-2xl flex-col gap-3 text-center">
				<span class="text-[12px] font-semibold text-idf-navy">Instalaciones</span>
				<h2 class="m-0 font-display text-[clamp(30px,3.6vw,44px)] leading-[1.12] text-idf-navy">Un lugar hecho para practicar</h2>
				<p class="m-0 text-[14px] leading-[1.75] text-idf-ink/50">Seis salones con luz natural, biblioteca de préstamo y café libre.</p>
			</div>
			<div class="grid w-full max-w-6xl auto-rows-[200px] grid-cols-4 gap-4 max-[1000px]:auto-rows-[170px] max-[1000px]:grid-cols-2 max-[640px]:auto-rows-[200px] max-[640px]:grid-cols-1">
				{facilities.map((f) => (
					<div
						class:list={[
							"overflow-hidden rounded-[24px] border border-idf-ink/6 bg-white max-[640px]:col-auto max-[640px]:row-auto",
							f.big && "col-span-2 row-span-2",
							f.wide && "col-span-2",
						]}
					>
						<img src={f.img} alt={f.alt} class="block h-full w-full object-cover" />
					</div>
				))}
			</div>
		</section>

		<section id="promociones" class="flex w-full scroll-mt-24 flex-col items-center px-6 pb-28">
			<div class="w-full max-w-6xl rounded-[32px] bg-idf-cream-alt px-10 py-16 max-[640px]:px-6 max-[640px]:py-12">
				<div class="mx-auto mb-12 flex max-w-2xl flex-col gap-3 text-center">
					<span class="text-[12px] font-semibold text-idf-navy">Precios</span>
					<h2 class="m-0 font-display text-[clamp(28px,3.4vw,42px)] leading-[1.12] text-idf-navy">Planes claros, sin costos escondidos</h2>
					<p class="m-0 text-[14px] leading-[1.75] text-idf-ink/50">El material digital ya está incluido en todos los planes.</p>
				</div>
				<div class="grid grid-cols-3 items-stretch gap-6 max-[1000px]:grid-cols-2 max-[640px]:grid-cols-1">
					{pricing.map((p) => (
						<div
							class:list={[
								"relative flex flex-col gap-6 rounded-[24px] p-7",
								p.featured ? "bg-idf-navy" : "border border-idf-ink/8 bg-white",
							]}
						>
							{p.featured && (
								<span class="absolute -top-3 left-7 rounded-full bg-idf-lime px-3 py-1 text-[10px] font-semibold tracking-[0.1em] text-idf-navy uppercase">Más elegido</span>
							)}
							<div class="flex flex-col gap-2">
								<h3 class:list={["m-0 font-display text-[19px]", p.featured ? "text-white" : "text-idf-navy"]}>{p.title}</h3>
								<p class:list={["m-0 text-[13px] leading-[1.7]", p.featured ? "text-white/60" : "text-idf-ink/55"]}>{p.desc}</p>
							</div>
							<div class="mt-auto">
								{p.oldPrice && <span class:list={["text-[13px] line-through", p.featured ? "text-white/40" : "text-idf-ink/35"]}>{p.oldPrice}</span>}
								<p class:list={["mt-0.5 mb-0 text-[34px] font-semibold", p.featured ? "text-white" : "text-idf-navy"]}>{p.price}{p.unit && <span class:list={["text-[14px] font-normal", p.featured ? "text-white/50" : "text-idf-ink/45"]}> {p.unit}</span>}</p>
							</div>
						</div>
					))}
				</div>
				<div class="mt-6 flex flex-wrap items-center justify-between gap-6 rounded-[24px] border border-idf-ink/8 bg-white px-8 py-7">
					<div class="flex flex-col gap-1.5">
						<span class="text-[10px] font-semibold tracking-[0.14em] text-idf-navy/45 uppercase">Promoción de agosto</span>
						<p class="m-0 mt-1 font-display text-[20px] text-idf-navy">Inscripción sin costo y examen de nivel gratis</p>
						<p class="m-0 text-[13px] text-idf-ink/50">Reservando antes del 28 de agosto · válido en los tres idiomas</p>
					</div>
					<a href={waPromo} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2.5 rounded-full bg-idf-navy px-6 py-3.5 text-[14px] font-medium text-white no-underline transition-all duration-300 hover:-translate-y-px hover:bg-idf-blue">
						Apartar por WhatsApp
					</a>
				</div>
			</div>
		</section>

		<section class="flex w-full justify-center px-6 pb-28">
			<div class="grid w-full max-w-6xl grid-cols-2 gap-6 max-[1000px]:grid-cols-1">
				{teasers.map((t) => (
					<a href={t.href} class="flex flex-col gap-5 rounded-[28px] border border-idf-ink/8 bg-white p-7 no-underline transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_14px_34px_rgba(12,43,25,0.10)]">
						<div class="h-52 overflow-hidden rounded-[20px]">
							<img src={t.img} alt={t.alt} class="block h-full w-full object-cover" />
						</div>
						<span class="text-[10px] font-semibold tracking-[0.14em] text-idf-navy/45 uppercase">{t.tag}</span>
						<h3 class="m-0 font-display text-[24px] leading-[1.2] text-idf-navy">{t.title}</h3>
						<p class="m-0 text-[14px] leading-[1.75] text-idf-ink/55">{t.desc}</p>
					</a>
				))}
			</div>
		</section>

		<section id="instagram" class="flex w-full scroll-mt-24 flex-col items-center px-6 pb-28">
			<div class="w-full max-w-6xl rounded-[32px] bg-idf-cream-alt px-10 py-16 max-[640px]:px-6 max-[640px]:py-12">
				<div class="mb-10 flex flex-wrap items-end justify-between gap-6">
					<div class="flex flex-col gap-2.5">
						<span class="text-[12px] font-semibold text-idf-navy">Instagram (cuenta de demostración)</span>
						<h2 class="m-0 font-display text-[clamp(28px,3.4vw,42px)] leading-[1.12] text-idf-navy">@idiomasdelfuturo</h2>
						<div class="mt-1 flex gap-6">
							<span class="text-[13px] text-idf-ink/50"><strong class="font-semibold text-idf-navy">312</strong> publicaciones</span>
							<span class="text-[13px] text-idf-ink/50"><strong class="font-semibold text-idf-navy">8,940</strong> seguidores</span>
							<span class="text-[13px] text-idf-ink/50"><strong class="font-semibold text-idf-navy">184</strong> siguiendo</span>
						</div>
					</div>
					<span class="rounded-[12px] bg-idf-navy px-6 py-3 text-[14px] font-medium text-white">Seguir</span>
				</div>
				<div class="grid grid-cols-3 gap-4 max-[1000px]:grid-cols-2 max-[640px]:grid-cols-1">
					{posts.map((p) => (
						<div class="relative aspect-square overflow-hidden rounded-[20px]">
							<img src={p.img} alt="Publicación" class="block h-full w-full object-cover" />
							<div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/72 to-transparent p-4">
								<p class="m-0 text-[12px] leading-snug text-white">{p.caption}</p>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<section id="resenas" class="flex w-full scroll-mt-24 flex-col items-center overflow-hidden py-28 max-[640px]:py-16">
			<div class="mx-auto mb-10 flex max-w-2xl flex-col gap-3 px-6 text-center">
				<span class="text-[12px] font-semibold text-idf-navy">Reseñas</span>
				<h2 class="m-0 font-display text-[clamp(30px,3.6vw,44px)] leading-[1.12] text-idf-navy">Lo que dicen nuestros alumnos</h2>
				<p class="m-0 text-[14px] leading-[1.75] text-idf-ink/50">Opiniones de muestra para este demo.</p>
			</div>
			<div class="mb-12 px-6">
				<div class="flex items-center gap-5 rounded-[20px] border border-idf-ink/8 bg-white px-7 py-5">
					<p class="m-0 text-[30px] font-semibold text-idf-navy">4.9</p>
					<div class="flex flex-col gap-0.5">
						<span class="text-[14px] tracking-wide text-idf-lime-deep">★★★★★</span>
						<span class="text-[12px] text-idf-ink/50">Basado en 214 reseñas</span>
					</div>
				</div>
			</div>
			<div class="w-full overflow-hidden">
				<div class="flex w-max animate-idf-marquee">
					{marqueeReviews.map((r) => (
						<div class="mx-2.5 box-border flex w-[330px] flex-col gap-4 rounded-[24px] border border-idf-ink/8 bg-white p-6">
							<span class="text-[13px] tracking-wide text-idf-lime-deep">★★★★★</span>
							<p class="m-0 text-[13px] leading-[1.8] text-idf-ink/60">"{r.text}"</p>
							<span class="text-[13px] font-medium text-idf-navy">{r.name}</span>
						</div>
					))}
				</div>
			</div>
		</section>

		<section id="ubicacion" class="flex w-full scroll-mt-24 flex-col items-center px-6 pb-28">
			<div class="w-full max-w-6xl rounded-[32px] bg-idf-cream-alt px-10 py-16 max-[640px]:px-6 max-[640px]:py-12">
				<div class="mx-auto mb-12 flex max-w-2xl flex-col gap-3 text-center">
					<span class="text-[12px] font-semibold text-idf-navy">Ubicación</span>
					<h2 class="m-0 font-display text-[clamp(28px,3.4vw,42px)] leading-[1.12] text-idf-navy">Estamos en el centro de Guadalajara</h2>
					<p class="m-0 text-[14px] leading-[1.75] text-idf-ink/50">Zona céntrica, con estacionamiento sin costo.</p>
				</div>
				<div class="grid grid-cols-[1fr_1.3fr] items-stretch gap-6 max-[1000px]:grid-cols-1">
					<div class="flex flex-col gap-3 rounded-[24px] border border-idf-ink/8 bg-white p-6">
						<div class="flex flex-col gap-2 rounded-[18px] bg-idf-cream-alt p-5">
							<h3 class="m-0 font-display text-[17px] text-idf-navy">Idiomas del Futuro</h3>
							<p class="m-0 text-[13px] leading-[1.7] text-idf-ink/55">Av. de los Idiomas 128, Col. El Mirador, Guadalajara, Jal. (dirección ficticia de demostración)</p>
						</div>
						<div class="flex flex-col gap-2 rounded-[18px] border border-idf-ink/8 p-5">
							<span class="text-[10px] font-semibold tracking-[0.14em] text-idf-navy/45 uppercase">Horarios</span>
							<p class="m-0 text-[13px] leading-[1.9] text-idf-ink/55">Lunes a viernes · 7:00 a 21:00<br />Sábados · 8:00 a 15:00</p>
						</div>
						<div class="flex flex-col gap-2 rounded-[18px] border border-idf-ink/8 p-5">
							<span class="text-[10px] font-semibold tracking-[0.14em] text-idf-navy/45 uppercase">Cómo llegar</span>
							<p class="m-0 text-[13px] leading-[1.9] text-idf-ink/55">Dos líneas de transporte troncal y varias rutas alimentadoras a menos de 10 minutos caminando.</p>
						</div>
						<a href={waVisita} target="_blank" rel="noopener noreferrer" class="mt-auto inline-flex items-center justify-center rounded-full bg-idf-navy px-6 py-3.5 text-[14px] font-medium text-white no-underline transition-colors duration-300 hover:bg-idf-blue">
							Agendar una visita
						</a>
					</div>
					<div class="relative min-h-[440px] overflow-hidden rounded-[24px] border border-idf-ink/8 bg-[#eef1ec]">
						<div class="absolute inset-0 bg-[repeating-linear-gradient(to_right,#e2e7df_0px,#e2e7df_92px,#ffffff_92px,#ffffff_106px),repeating-linear-gradient(to_bottom,rgba(0,0,0,0)_0px,rgba(0,0,0,0)_78px,#ffffff_78px,#ffffff_92px)]"></div>
						<div class="absolute top-[34%] left-[-8%] h-8.5 w-[120%] rotate-[-11deg] bg-white"></div>
						<div class="absolute top-[35.4%] left-[-8%] h-0.75 w-[120%] rotate-[-11deg] bg-idf-lime"></div>
						<div class="absolute top-[62%] left-[8%] flex h-[120px] w-[180px] items-center justify-center rounded-[18px] bg-[#d5e5c9] text-[10px] tracking-[0.14em] text-idf-navy/40 uppercase">Parque</div>
						<div class="absolute top-[12%] right-[10%] flex h-24 w-[150px] items-center justify-center rounded-2xl bg-[#e4eae2] text-[10px] tracking-[0.14em] text-idf-navy/40 uppercase">Plaza</div>
						<div class="absolute top-[48%] left-[47%] flex -translate-x-1/2 -translate-y-full flex-col items-center gap-2">
							<span class="rounded-[10px] bg-idf-navy px-3 py-1.5 text-[11px] font-medium whitespace-nowrap text-white shadow-[0_8px_20px_rgba(12,43,25,0.28)]">Idiomas del Futuro</span>
							<span class="h-4.5 w-4.5 rounded-full border-4 border-white bg-idf-lime shadow-[0_4px_10px_rgba(0,0,0,0.18)]"></span>
						</div>
						<span class="absolute top-[24%] left-[5%] rotate-[-11deg] text-[10px] text-idf-ink/35">Av. de los Idiomas</span>
						<span class="absolute right-[6%] bottom-[16%] text-[10px] text-idf-ink/35">Calle El Mirador</span>
						<span class="absolute bottom-4 left-5 text-[10px] tracking-[0.14em] text-idf-navy/40 uppercase">Mapa ilustrativo</span>
					</div>
				</div>
			</div>
		</section>

		<SiteFooter />
		<FloatingDock />
	</div>
</Layout>
