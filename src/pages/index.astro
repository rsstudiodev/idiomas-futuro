---
import Layout from "@/layouts/Layout.astro";
import FloatingDock from "@/components/FloatingDock.astro";
import SiteFooter from "@/components/SiteFooter.astro";
const waPromo = "https://wa.me/523311223344?text=Quiero%20la%20promoci%C3%B3n%20de%20agosto";
const waVisita = "https://wa.me/523311223344?text=Quiero%20agendar%20una%20visita";

const services = [
	{
		tag: "Idioma",
		title: "Inglés general",
		desc: "Del A1 al C1 en seis niveles de cuatro meses. Dos sesiones por semana.",
		price: "$1,290",
		unit: "/mes",
		href: `/idiomas-futuro/calendarios#ingles`,
	},
	{
		tag: "Idioma",
		title: "Portugués de Brasil",
		desc: "Pronunciación carioca, negocios y trámites. Niveles A1 a B2.",
		price: "$1,190",
		unit: "/mes",
		href: `/idiomas-futuro/calendarios#portugues`,
	},
	{
		tag: "Idioma",
		title: "Chino mandarín",
		desc: "Tonos, pinyin y caracteres con apoyo de escritura guiada. HSK 1 a 4.",
		price: "$1,490",
		unit: "/mes",
		href: `/idiomas-futuro/calendarios#chino`,
	},
];

const extras = [
	{
		tag: "Práctica",
		title: "Club de conversación",
		desc: "Sesiones abiertas de 90 minutos, sábados. Gratis para alumnos inscritos.",
		price: "$180",
		unit: "/ sesión suelta",
	},
	{
		tag: "Certificación",
		title: "Preparación de exámenes",
		desc: "Simulacros cronometrados y retroalimentación individual. 8 semanas.",
		price: "$3,600",
		unit: "/ curso",
	},
	{
		tag: "Empresas",
		title: "Cursos in-company",
		desc: "Vamos a tu oficina o en línea, con reportes mensuales de avance.",
		price: "Cotización",
		unit: "a medida",
	},
];

const startDates = [
	{ title: "Inglés A1 · Lu-Mi 19:00", date: "Inicia 3 de septiembre", seats: "6 lugares", highlight: true },
	{ title: "Portugués A2 · Sáb 10:00", date: "Inicia 12 de septiembre", seats: "4 lugares", highlight: false },
	{ title: "Chino HSK 1 · Ma-Ju 18:00", date: "Inicia 22 de septiembre", seats: "8 lugares", highlight: false },
];

const facilities = [
	{ img: "https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1200&q=80", alt: "Salón principal", big: true },
	{ img: "https://images.unsplash.com/photo-1524758631624-e2822e304c36?auto=format&fit=crop&w=1200&q=80", alt: "Sala de estudio", wide: true },
	{ img: "https://images.unsplash.com/photo-1521737604893-d14cc237f11d?auto=format&fit=crop&w=900&q=80", alt: "Club de conversación" },
	{ img: "https://images.unsplash.com/photo-1580582932707-520aed937b7b?auto=format&fit=crop&w=900&q=80", alt: "Biblioteca de préstamo" },
];

const pricing = [
	{ title: "Mensual", desc: "2 clases por semana, 8 sesiones al mes.", price: "$1,290", featured: false },
	{ title: "Trimestral", desc: "Un nivel completo, con examen de certificación interna.", price: "$3,290", oldPrice: "$3,870", featured: true },
	{ title: "Clases privadas", desc: "Uno a uno, presencial o en línea, horario abierto.", price: "$420", unit: "/hora", featured: false },
];

const teasers = [
	{
		href: `/idiomas-futuro/metodo`,
		img: "https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1200&q=80",
		alt: "Clase en curso",
		tag: "Método",
		title: "70% del tiempo hablando, 30% explicando",
		desc: "Cómo estructuramos cada sesión y por qué avanzas más rápido. →",
	},
	{
		href: `/idiomas-futuro/profesores`,
		img: "https://images.unsplash.com/photo-1524178232363-1fb2b075b655?auto=format&fit=crop&w=1200&q=80",
		alt: "Profesora con alumnos",
		tag: "Equipo",
		title: "Cuatro profesores, cuatro acentos reales",
		desc: "Conoce a quién vas a tener enfrente cada semana. →",
	},
];

const posts = [
	{ img: "https://images.unsplash.com/photo-1543269865-cbf427effbad?auto=format&fit=crop&w=800&q=80", caption: "Nuestro grupo de B1 cerró el nivel con un debate de 40 minutos ☕ 214 ♥" },
	{ img: "https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=800&q=80", caption: "Tres palabras en portugués que todos confundimos · 158 ♥" },
	{ img: "https://images.unsplash.com/photo-1503676260728-1c00da094a0b?auto=format&fit=crop&w=800&q=80", caption: "Los 4 tonos del mandarín explicados con canciones · 402 ♥" },
	{ img: "https://images.unsplash.com/photo-1571260899304-425eee4c7efc?auto=format&fit=crop&w=800&q=80", caption: "Club de lectura del sábado: cuentos cortos en inglés · 96 ♥" },
	{ img: "https://images.unsplash.com/photo-1517048676732-d65bc937f952?auto=format&fit=crop&w=800&q=80", caption: "Curso in-company en una agencia de Zapopan · 73 ♥" },
	{ img: "https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&w=800&q=80", caption: "Abrimos dos grupos nuevos de A1 por la mañana · 121 ♥" },
];

const reviews = [
	{ name: "Andrea Villalobos", text: "Llevaba años diciendo que iba a retomar el inglés. Aquí hablé desde la primera clase y ya no me da miedo el teléfono en el trabajo." },
	{ name: "Rodrigo Cázares", text: "Tomé portugués antes de mudarme a São Paulo. Los profes te corrigen la pronunciación sin hacerte sentir mal." },
	{ name: "Marisol Fregoso", text: "Mi hija entró a chino con 14 años y ya escribe sus primeros caracteres. El grupo pequeño hace toda la diferencia." },
	{ name: "Diego Palomera", text: "Contratamos el curso in-company para seis personas del equipo. Reportes claros cada mes y cero faltas." },
	{ name: "Paulina Iñiguez", text: "El club de conversación de los sábados vale la inscripción por sí solo." },
	{ name: "Ana Karen Ruvalcaba", text: "Pasé el examen de certificación en el primer intento después del curso de preparación." },
];
const marqueeReviews = [...reviews, ...reviews];
---

<Layout title="Idiomas del Futuro — Escuela de idiomas">
	<div class="w-full overflow-x-hidden bg-idf-cream pb-24 text-idf-ink">
		<section class="relative flex min-h-screen w-full flex-col items-center justify-center overflow-hidden border-b border-idf-navy/10 px-6 pt-[120px] pb-24 max-[640px]:pt-[88px]">
			<div class="absolute inset-0 bg-[radial-gradient(120%_90%_at_50%_-10%,#b9d1ee_0%,#d8e5f4_28%,#eeeee6_58%,#faf6ec_82%)]"></div>
			<div class="absolute inset-0 bg-[repeating-conic-gradient(from_200deg_at_50%_-12%,rgba(255,255,255,0.55)_0deg_1.6deg,rgba(255,255,255,0)_1.6deg_5deg)] [mask-image:linear-gradient(to_bottom,rgba(0,0,0,.9),transparent_62%)]"></div>
			<div class="pointer-events-none fixed inset-0 z-50 flex items-center justify-center" aria-hidden="true">
				<div
					id="hero-logo-fly"
					class="hero-motion relative flex h-[40vmin] w-[40vmin] items-center justify-center rounded-[28%] bg-idf-navy opacity-0 md:h-[30vmin] md:w-[30vmin] [animation:idf-hero-logo-intro_1.4s_ease-in-out_forwards]"
				>
					<span class="block h-[38%] w-[38%] rounded-full border-4 border-idf-cream"></span>
					<span class="absolute top-[16%] right-[16%] h-[19%] w-[19%] rotate-45 bg-idf-amber"></span>
				</div>
			</div>

			<div class="relative flex max-w-3xl flex-col items-center gap-8 text-center">
				<div class="hero-motion mb-2 flex flex-col items-center gap-4 opacity-0 [animation:idf-hero-logo-settle_0.5s_ease-out_1.2s_forwards]">
					<div id="hero-logo-target" class="relative flex h-27 w-27 items-center justify-center rounded-[32px] bg-idf-navy shadow-[0_18px_44px_rgba(20,52,92,0.22)]">
						<span class="block h-10.5 w-10.5 rounded-full border-[5px] border-idf-cream"></span>
						<span class="absolute top-4.25 right-4.25 h-5.25 w-5.25 rotate-45 bg-idf-amber"></span>
					</div>
					<span class="font-sans text-[11px] tracking-[0.3em] text-idf-navy/60 uppercase">Idiomas del Futuro</span>
				</div>
				<h1 class="hero-motion m-0 text-balance font-display text-[clamp(46px,6.4vw,92px)] leading-[1.02] tracking-tight text-idf-navy opacity-0 [animation:idf-hero-reveal_0.7s_ease-out_1.55s_forwards]">
					Aprende el idioma<br />que abre tu futuro
				</h1>
				<p class="hero-motion m-0 max-w-[56ch] text-pretty font-sans text-[17px] leading-loose text-idf-ink/66 opacity-0 [animation:idf-hero-reveal_0.7s_ease-out_1.7s_forwards]">
					Inglés, portugués y chino mandarín en grupos de máximo 8 personas. Conversas desde la primera clase, con profesores certificados y horarios que sí cabe en tu semana.
				</p>
			</div>

			<script is:inline>
				(function () {
					var flyer = document.getElementById("hero-logo-fly");
					var target = document.getElementById("hero-logo-target");
					if (!flyer || !target) return;
					if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
						flyer.style.display = "none";
						return;
					}
					var fr = flyer.getBoundingClientRect();
					var tr = target.getBoundingClientRect();
					var dx = tr.left + tr.width / 2 - (fr.left + fr.width / 2);
					var dy = tr.top + tr.height / 2 - (fr.top + fr.height / 2);
					var scale = tr.width / fr.width;
					flyer.style.setProperty("--idf-hero-tx", dx + "px");
					flyer.style.setProperty("--idf-hero-ty", dy + "px");
					flyer.style.setProperty("--idf-hero-ts", String(scale));
				})();
			</script>
		</section>

		<section class="flex w-full flex-col items-center gap-9 px-6 py-20">
			<span class="rounded-full border border-idf-navy/12 bg-idf-cream-light px-4 py-1.75 font-sans text-[11px] tracking-[0.16em] text-idf-navy/60 uppercase">Avalados por</span>
			<div class="grid w-full max-w-[1000px] grid-cols-4 items-center justify-items-center gap-8 max-[1000px]:grid-cols-2 max-[640px]:grid-cols-1">
				<span class="font-sans text-[19px] tracking-wide text-idf-navy/45">CELPE Norte</span>
				<span class="font-sans text-[19px] tracking-wide text-idf-navy/45">Instituto Yuán</span>
				<span class="font-sans text-[19px] tracking-wide text-idf-navy/45">Consorcio Lusófono</span>
				<span class="font-sans text-[19px] tracking-wide text-idf-navy/45">Red ANLE</span>
			</div>
		</section>

		<section id="servicios" class="flex w-full scroll-mt-24 flex-col items-center px-6 py-32 max-[1000px]:py-22 max-[640px]:py-16">
			<div class="mx-auto mb-16 flex max-w-3xl flex-col gap-4 text-center">
				<h2 class="m-0 font-display text-[clamp(34px,4vw,52px)] leading-tight tracking-tight text-idf-navy">Nuestros servicios</h2>
				<p class="m-0 font-sans text-[17px] leading-loose text-idf-ink/62">Todo lo que ofrecemos, con precios claros y grupos reducidos.</p>
			</div>
			<div class="grid w-full max-w-6xl grid-cols-3 gap-8 max-[1000px]:grid-cols-2 max-[640px]:grid-cols-1">
				{services.map((s) => (
					<div class="flex flex-col gap-6 rounded-[32px] border border-idf-navy/12 bg-idf-cream-light p-8 shadow-sm transition-all duration-300 hover:border-idf-navy/28 hover:shadow-[0_12px_30px_rgba(20,52,92,0.10)]">
						<div class="flex flex-col gap-2.5 rounded-3xl bg-idf-blue-soft p-6">
							<span class="font-sans text-[11px] tracking-[0.16em] text-idf-navy/60 uppercase">{s.tag}</span>
							<h3 class="m-0 font-display text-2xl text-idf-navy">{s.title}</h3>
							<p class="m-0 font-sans text-sm leading-relaxed text-idf-ink/66">{s.desc}</p>
						</div>
						<div class="mt-auto flex items-end justify-between gap-4">
							<div>
								<span class="font-sans text-xs text-idf-navy/55">Desde</span>
								<p class="mt-0.5 mb-0 font-sans text-3xl whitespace-nowrap text-idf-navy">{s.price}<span class="text-sm text-idf-ink/50"> {s.unit}</span></p>
							</div>
							<a href={s.href} class="rounded-full bg-idf-blue/8 px-4 py-2.25 font-sans text-[13px] text-idf-blue no-underline hover:bg-idf-blue/16">Inicios</a>
						</div>
					</div>
				))}
				{extras.map((e) => (
					<div class="flex flex-col gap-4 rounded-[32px] border border-idf-navy/12 bg-idf-cream-light p-8 shadow-sm transition-all duration-300 hover:border-idf-navy/28 hover:shadow-[0_12px_30px_rgba(20,52,92,0.10)]">
						<span class="font-sans text-[11px] tracking-[0.16em] text-idf-amber uppercase">{e.tag}</span>
						<h3 class="m-0 font-display text-[22px] text-idf-navy">{e.title}</h3>
						<p class="m-0 font-sans text-sm leading-relaxed text-idf-ink/66">{e.desc}</p>
						<p class="mt-2 mb-0 font-sans text-[22px] text-idf-navy">{e.price} <span class="text-[13px] text-idf-ink/50">{e.unit}</span></p>
					</div>
				))}
			</div>
		</section>

		<section class="flex w-full justify-center px-6 pt-16 pb-32">
			<div class="grid w-full max-w-6xl grid-cols-[1.1fr_1fr] items-center gap-14 rounded-[40px] bg-idf-navy p-16 shadow-[0_20px_60px_rgba(20,52,92,0.18)] max-[1000px]:grid-cols-1 max-[1000px]:gap-8 max-[1000px]:p-8 max-[640px]:p-6">
				<div class="flex flex-col gap-6">
					<span class="font-sans text-[11px] tracking-[0.18em] text-idf-amber uppercase">Calendario 2026</span>
					<h2 class="m-0 font-display text-[clamp(32px,3.6vw,46px)] leading-tight tracking-tight text-idf-cream">Consulta los próximos inicios antes de que se llenen</h2>
					<p class="m-0 max-w-[44ch] font-sans text-base leading-loose text-idf-cream/72">Cada nivel abre un grupo nuevo cada mes. En el calendario ves fechas, horarios, cupo disponible y el nivel que te corresponde.</p>
					<a href={`/idiomas-futuro/calendarios`} class="inline-flex items-center gap-3 self-start rounded-full bg-idf-cream px-7.5 py-4 font-sans text-base text-idf-navy no-underline transition-all duration-300 hover:-translate-y-px hover:bg-white">
						Ver calendario de inicios →
					</a>
				</div>
				<div class="flex flex-col gap-3">
					{startDates.map((s) => (
						<div class="flex items-center justify-between gap-4 rounded-[20px] border border-idf-cream/14 bg-idf-cream/8 px-6 py-5">
							<div>
								<p class="m-0 font-sans text-[17px] text-idf-cream">{s.title}</p>
								<p class="mt-1 mb-0 font-sans text-xs text-idf-cream/60">{s.date}</p>
							</div>
							<span class:list={["whitespace-nowrap rounded-full px-3 py-1.5 font-sans text-xs", s.highlight ? "bg-idf-amber text-[#2b1a05]" : "bg-idf-cream/16 text-idf-cream"]}>{s.seats}</span>
						</div>
					))}
				</div>
			</div>
		</section>

		<section id="instalaciones" class="flex w-full scroll-mt-24 flex-col items-center bg-idf-cream-alt px-6 py-32 max-[1000px]:py-22 max-[640px]:py-16">
			<div class="mx-auto mb-16 flex max-w-3xl flex-col gap-4 text-center">
				<h2 class="m-0 font-display text-[clamp(34px,4vw,52px)] leading-tight tracking-tight text-idf-navy">Nuestras instalaciones</h2>
				<p class="m-0 font-sans text-[17px] leading-loose text-idf-ink/62">Seis salones con luz natural, biblioteca de préstamo y café libre.</p>
			</div>
			<div class="grid w-full max-w-6xl grid-cols-4 auto-rows-[200px] gap-5 max-[1000px]:grid-cols-2 max-[1000px]:auto-rows-[170px] max-[640px]:grid-cols-1 max-[640px]:auto-rows-[200px]">
				{facilities.map((f) => (
					<div
						class:list={[
							"overflow-hidden rounded-[32px] border border-idf-navy/12 bg-idf-cream-light max-[640px]:col-auto max-[640px]:row-auto",
							f.big && "col-span-2 row-span-2",
							f.wide && "col-span-2",
						]}
					>
						<img src={f.img} alt={f.alt} class="block h-full w-full object-cover saturate-60" />
					</div>
				))}
			</div>
		</section>

		<section id="promociones" class="flex w-full scroll-mt-24 flex-col items-center px-6 py-32 max-[1000px]:py-22 max-[640px]:py-16">
			<div class="mx-auto mb-16 flex max-w-3xl flex-col gap-4 text-center">
				<h2 class="m-0 font-display text-[clamp(34px,4vw,52px)] leading-tight tracking-tight text-idf-navy">Promociones y precios</h2>
				<p class="m-0 font-sans text-[17px] leading-loose text-idf-ink/62">Sin inscripción escondida: el material digital ya está incluido.</p>
			</div>
			<div class="grid w-full max-w-6xl grid-cols-3 items-stretch gap-8 max-[1000px]:grid-cols-2 max-[640px]:grid-cols-1">
				{pricing.map((p) => (
					<div
						class:list={[
							"relative flex flex-col gap-7 rounded-[32px] bg-idf-cream-light p-9",
							p.featured ? "border-2 border-idf-blue shadow-[0_16px_40px_rgba(20,52,92,0.12)]" : "border border-idf-navy/12 shadow-sm",
						]}
					>
						{p.featured && (
							<span class="absolute -top-3.5 left-9 rounded-full bg-idf-blue px-3.5 py-1.5 font-sans text-[11px] tracking-[0.14em] text-idf-cream uppercase">Más elegido</span>
						)}
						<div class="flex flex-col gap-2">
							<h3 class="m-0 font-display text-[22px] text-idf-navy">{p.title}</h3>
							<p class="m-0 font-sans text-sm leading-relaxed text-idf-ink/66">{p.desc}</p>
						</div>
						<div class="mt-auto">
							{p.oldPrice && <span class="font-sans text-sm text-idf-ink/42 line-through">{p.oldPrice}</span>}
							<p class="mt-0.5 mb-0 font-sans text-[38px] text-idf-navy">{p.price}{p.unit && <span class="text-[15px] text-idf-ink/50"> {p.unit}</span>}</p>
						</div>
					</div>
				))}
			</div>
			<div class="mt-8 flex w-full max-w-6xl flex-wrap items-center justify-between gap-8 rounded-[32px] border border-idf-navy/14 bg-idf-blue-soft px-10 py-8">
				<div class="flex flex-col gap-1.5">
					<span class="font-sans text-[11px] tracking-[0.16em] text-idf-amber uppercase">Promoción de agosto</span>
					<p class="m-0 font-sans text-2xl text-idf-navy">Inscripción sin costo y examen de nivel gratis</p>
					<p class="m-0 font-sans text-sm text-idf-ink/62">Reservando antes del 28 de agosto · válido en los tres idiomas</p>
				</div>
				<a href={waPromo} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2.5 rounded-full bg-idf-whatsapp px-7 py-3.75 font-sans text-[15px] font-semibold text-idf-whatsapp-ink no-underline transition-all duration-300 hover:-translate-y-px hover:shadow-[0_10px_26px_rgba(37,211,102,0.35)]">
					Apartar por WhatsApp
				</a>
			</div>
		</section>

		<section class="flex w-full justify-center px-6 pb-32">
			<div class="grid w-full max-w-6xl grid-cols-2 gap-8 max-[1000px]:grid-cols-1">
				{teasers.map((t) => (
					<a href={t.href} class="flex flex-col gap-6 rounded-[40px] border border-idf-navy/12 bg-idf-cream-light p-10 no-underline transition-all duration-300 hover:border-idf-navy/28 hover:shadow-[0_14px_36px_rgba(20,52,92,0.10)]">
						<div class="h-55 overflow-hidden rounded-3xl">
							<img src={t.img} alt={t.alt} class="block h-full w-full object-cover saturate-60" />
						</div>
						<span class="font-sans text-[11px] tracking-[0.16em] text-idf-navy/55 uppercase">{t.tag}</span>
						<h3 class="m-0 font-display text-[30px] leading-tight text-idf-navy">{t.title}</h3>
						<p class="m-0 font-sans text-[15px] leading-loose text-idf-ink/66">{t.desc}</p>
					</a>
				))}
			</div>
		</section>

		<section id="instagram" class="flex w-full scroll-mt-24 flex-col items-center bg-idf-cream-alt px-6 py-32 max-[1000px]:py-22 max-[640px]:py-16">
			<div class="mb-12 flex w-full max-w-6xl flex-wrap items-end justify-between gap-8">
				<div class="flex flex-col gap-3">
					<span class="font-sans text-[11px] tracking-[0.16em] text-idf-navy/55 uppercase">Instagram (cuenta de demostración)</span>
					<h2 class="m-0 font-display text-[clamp(34px,4vw,52px)] leading-tight tracking-tight text-idf-navy">@idiomasdelfuturo</h2>
					<div class="mt-1 flex gap-7">
						<span class="font-sans text-sm text-idf-ink/62"><strong class="font-sans text-idf-navy">312</strong> publicaciones</span>
						<span class="font-sans text-sm text-idf-ink/62"><strong class="font-sans text-idf-navy">8,940</strong> seguidores</span>
						<span class="font-sans text-sm text-idf-ink/62"><strong class="font-sans text-idf-navy">184</strong> siguiendo</span>
					</div>
				</div>
				<span class="rounded-full bg-idf-navy px-6.5 py-3.5 font-sans text-[15px] text-idf-cream">Seguir</span>
			</div>
			<div class="grid w-full max-w-6xl grid-cols-3 gap-5 max-[1000px]:grid-cols-2 max-[640px]:grid-cols-1">
				{posts.map((p) => (
					<div class="relative aspect-square overflow-hidden rounded-3xl border border-idf-navy/12">
						<img src={p.img} alt="Publicación" class="block h-full w-full object-cover" />
						<div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/72 to-transparent p-5">
							<p class="m-0 font-sans text-[13px] text-idf-cream">{p.caption}</p>
						</div>
					</div>
				))}
			</div>
		</section>

		<section id="resenas" class="flex w-full scroll-mt-24 flex-col items-center overflow-hidden py-32">
			<div class="mx-auto mb-10 flex max-w-3xl flex-col gap-4 px-6 text-center">
				<h2 class="m-0 font-display text-[clamp(34px,4vw,52px)] leading-tight tracking-tight text-idf-navy">Reseñas</h2>
				<p class="m-0 font-sans text-[17px] leading-loose text-idf-ink/62">Opiniones de muestra para este demo.</p>
			</div>
			<div class="mb-14 w-full max-w-[420px] px-6">
				<div class="flex items-center justify-center gap-6 rounded-[32px] border border-idf-navy/12 bg-idf-cream-light p-6 shadow-sm">
					<p class="m-0 font-sans text-[34px] text-idf-navy">4.9</p>
					<div class="flex flex-col gap-1">
						<span class="font-sans text-[15px] tracking-wide text-idf-amber">★★★★★</span>
						<span class="font-sans text-[13px] text-idf-ink/62">Basado en 214 reseñas</span>
					</div>
				</div>
			</div>
			<div class="w-full overflow-hidden">
				<div class="flex w-max animate-idf-marquee">
					{marqueeReviews.map((r) => (
						<div class="mx-3 box-border flex w-[340px] flex-col gap-4 rounded-[32px] border border-idf-navy/12 bg-idf-cream-light p-7 shadow-sm">
							<span class="font-sans text-sm tracking-wide text-idf-amber">★★★★★</span>
							<p class="m-0 font-sans text-sm leading-loose text-idf-ink/70">"{r.text}"</p>
							<span class="font-sans text-[13px] text-idf-navy">{r.name}</span>
						</div>
					))}
				</div>
			</div>
		</section>

		<section id="ubicacion" class="flex w-full scroll-mt-24 flex-col items-center bg-idf-cream-alt px-6 py-32 max-[1000px]:py-22 max-[640px]:py-16">
			<div class="mx-auto mb-16 flex max-w-3xl flex-col gap-4 text-center">
				<h2 class="m-0 font-display text-[clamp(34px,4vw,52px)] leading-tight tracking-tight text-idf-navy">Nuestra ubicación</h2>
				<p class="m-0 font-sans text-[17px] leading-loose text-idf-ink/62">En zona céntrica de Guadalajara, con estacionamiento sin costo.</p>
			</div>
			<div class="grid w-full max-w-[1000px] grid-cols-[1fr_1.3fr] items-stretch gap-8 max-[1000px]:grid-cols-1">
				<div class="flex flex-col gap-4 rounded-[32px] border border-idf-navy/12 bg-idf-cream-light p-8 shadow-sm">
					<div class="flex flex-col gap-2 rounded-3xl bg-idf-blue-soft p-6">
						<h3 class="m-0 font-display text-[19px] text-idf-navy">Idiomas del Futuro</h3>
						<p class="m-0 font-sans text-sm leading-relaxed text-idf-ink/66">Av. de los Idiomas 128, Col. El Mirador, Guadalajara, Jal. (dirección ficticia de demostración)</p>
					</div>
					<div class="flex flex-col gap-2 rounded-3xl bg-idf-blue/6 p-6">
						<span class="font-sans text-[11px] tracking-[0.16em] text-idf-navy/55 uppercase">Horarios</span>
						<p class="m-0 font-sans text-sm leading-[1.9] text-idf-ink/66">Lunes a viernes · 7:00 a 21:00<br />Sábados · 8:00 a 15:00</p>
					</div>
					<div class="flex flex-col gap-2 rounded-3xl bg-idf-blue/6 p-6">
						<span class="font-sans text-[11px] tracking-[0.16em] text-idf-navy/55 uppercase">Cómo llegar</span>
						<p class="m-0 font-sans text-sm leading-[1.9] text-idf-ink/66">Dos líneas de transporte troncal y varias rutas alimentadoras a menos de 10 minutos caminando.</p>
					</div>
					<a href={waVisita} target="_blank" rel="noopener noreferrer" class="mt-auto inline-flex items-center justify-center gap-2.5 rounded-full bg-idf-navy px-6 py-3.75 font-sans text-[15px] text-idf-cream no-underline transition-all duration-300 hover:bg-idf-blue">
						Agendar una visita
					</a>
				</div>
				<div class="relative min-h-[460px] overflow-hidden rounded-[32px] border border-idf-navy/12 bg-[#eef1e9]">
					<div class="absolute inset-0 bg-[repeating-linear-gradient(to_right,#dfe4d9_0px,#dfe4d9_92px,#fffdf8_92px,#fffdf8_106px),repeating-linear-gradient(to_bottom,rgba(0,0,0,0)_0px,rgba(0,0,0,0)_78px,#fffdf8_78px,#fffdf8_92px)]"></div>
					<div class="absolute top-[34%] left-[-8%] h-8.5 w-[120%] rotate-[-11deg] bg-idf-cream-light shadow-[0_0_0_1px_rgba(20,52,92,0.06)]"></div>
					<div class="absolute top-[35.4%] left-[-8%] h-0.75 w-[120%] rotate-[-11deg] bg-idf-amber/70"></div>
					<div class="absolute top-[62%] left-[8%] h-[120px] w-[180px] rounded-[18px] bg-[#cfdcc6]"></div>
					<div class="absolute top-[62%] left-[8%] flex h-[120px] w-[180px] items-center justify-center font-sans text-[11px] tracking-[0.14em] text-idf-ink/42 uppercase">Parque</div>
					<div class="absolute top-[12%] right-[10%] h-24 w-[150px] rounded-2xl bg-[#dde6f1]"></div>
					<div class="absolute top-[12%] right-[10%] flex h-24 w-[150px] items-center justify-center font-sans text-[11px] tracking-[0.14em] text-idf-navy/40 uppercase">Plaza</div>
					<div class="absolute top-[48%] left-[47%] flex -translate-x-1/2 -translate-y-full flex-col items-center gap-2">
						<span class="rounded-full bg-idf-navy px-4 py-2.25 font-sans text-xs tracking-wide whitespace-nowrap text-idf-cream shadow-[0_8px_20px_rgba(20,52,92,0.25)]">Idiomas del Futuro</span>
						<span class="h-4.5 w-4.5 rounded-full border-4 border-idf-cream-light bg-idf-whatsapp shadow-[0_4px_10px_rgba(28,26,22,0.2)]"></span>
					</div>
					<span class="absolute top-[24%] left-[5%] rotate-[-11deg] font-sans text-[11px] text-idf-ink/38">Av. de los Idiomas</span>
					<span class="absolute right-[6%] bottom-[16%] font-sans text-[11px] text-idf-ink/38">Calle El Mirador</span>
					<span class="absolute bottom-4 left-5 rounded-full border border-idf-navy/12 bg-idf-cream-light/92 px-3.5 py-1.75 font-sans text-[10px] tracking-[0.16em] text-idf-navy/55 uppercase">Mapa ilustrativo</span>
				</div>
			</div>
		</section>

		<SiteFooter />
		<FloatingDock />
	</div>
</Layout>
