---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import FloatingDock from "@/components/FloatingDock.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { waHref } from "@/config/whatsapp";
import { Check } from "@lucide/astro";
const stats = [
	{ value: "70%", desc: "del tiempo de clase lo pasas hablando o escribiendo tú, no escuchando al profesor." },
	{ value: "8", desc: "personas como máximo por grupo, para que cada quien tenga turno en cada actividad." },
	{ value: "4", desc: "reportes de avance al año, con grabaciones tuyas del primer y del último día." },
];

const timeline = [
	{ time: "0–15 min", title: "Arranque hablado", desc: "En parejas, sobre algo que te pasó esta semana. Nadie abre el libro todavía y nadie corrige aún." },
	{ time: "15–40 min", title: "Entrada de contexto", desc: "Un audio, un video corto o un texto real: una nota de prensa, un menú, un chat de trabajo. Primero entiendes, después analizas." },
	{ time: "40–60 min", title: "La regla, cuando ya la necesitas", desc: "Veinte minutos de gramática explicada sobre los ejemplos que acabas de escuchar, no sobre frases inventadas." },
	{ time: "60–100 min", title: "Tarea con resultado", desc: "Negociar una renta, resolver una queja, presentar tu proyecto. Se hace en equipo y se presenta frente al grupo." },
	{ time: "100–120 min", title: "Corrección amable", desc: "El profesor devuelve los errores más útiles del día, anónimos y en el pizarrón. Te vas con tres cosas concretas que mejorar." },
];

const notDone = [
	"Material digital incluido, sin comprar libros aparte",
	"Puedes reponer una clase perdida con otro grupo del mismo nivel",
	"Certificación interna al terminar cada nivel",
];
---

<Layout title="Nuestro método — Idiomas del Futuro">
	<div class="w-full overflow-x-hidden bg-idf-cream pb-24 text-idf-ink">
		<PageHero
			kicker="Método · 70% del tiempo hablando"
			title="Nuestro método"
			description="Hablas el 70% de la clase. Explicamos gramática solo cuando ya la necesitas para decir algo que quieres decir. Así se ve una sesión de dos horas con nosotros."
			image="https://images.unsplash.com/photo-1524178232363-1fb2b075b655?auto=format&fit=crop&w=2000&q=80"
			imageAlt="Profesora acompañando a un grupo pequeño en clase"
			focus="58% 38%"
			focusMobile="55% 25%"
		/>

		<section class="relative z-10 -mt-16 flex w-full flex-col items-center px-6 pb-24">
			<div class="grid w-full max-w-[1000px] grid-cols-3 gap-5 max-[1000px]:grid-cols-2 max-[640px]:grid-cols-1">
				{stats.map((s) => (
					<div class="flex flex-col gap-2 rounded-[24px] bg-white p-7 shadow-[0_18px_44px_rgba(12,43,25,0.14)]">
						<span class="font-display text-[38px] text-idf-navy">{s.value}</span>
						<p class="m-0 text-[13px] leading-[1.75] text-idf-ink/55">{s.desc}</p>
					</div>
				))}
			</div>
		</section>

		<section class="flex w-full justify-center px-6 pb-28">
			<div class="w-full max-w-6xl rounded-[32px] bg-idf-cream-alt px-10 py-16 max-[640px]:px-6 max-[640px]:py-12">
				<div class="mx-auto mb-12 flex max-w-2xl flex-col gap-3 text-center">
					<span class="text-[12px] font-semibold text-idf-navy">Paso a paso</span>
					<h2 class="m-0 font-display text-[clamp(28px,3.4vw,42px)] leading-[1.12] text-idf-navy">Una clase de dos horas, minuto a minuto</h2>
					<p class="m-0 text-[14px] leading-[1.75] text-idf-ink/50">La misma estructura en los tres idiomas, del primer nivel al último.</p>
				</div>
				<div class="mx-auto flex w-full max-w-[860px] flex-col gap-3">
					{timeline.map((step) => (
						<div class="grid grid-cols-[110px_1fr] items-start gap-6 rounded-[24px] border border-idf-ink/8 bg-white p-6 max-[640px]:grid-cols-1 max-[640px]:gap-2">
							<span class="pt-1 text-[12px] font-medium text-idf-navy/45">{step.time}</span>
							<div class="flex flex-col gap-1.5">
								<h3 class="m-0 font-display text-[19px] text-idf-navy">{step.title}</h3>
								<p class="m-0 text-[13px] leading-[1.8] text-idf-ink/55">{step.desc}</p>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="flex w-full justify-center px-6 py-28 max-[1000px]:py-22 max-[640px]:py-16">
			<div class="grid w-full max-w-[1000px] grid-cols-2 items-center gap-12 max-[1000px]:grid-cols-1">
				<div class="aspect-4/3 overflow-hidden rounded-[28px]">
					<img src="https://images.unsplash.com/photo-1517048676732-d65bc937f952?auto=format&fit=crop&w=1200&q=80" alt="Trabajo en equipo en clase" class="block h-full w-full object-cover" />
				</div>
				<div class="flex flex-col gap-5">
					<span class="text-[12px] font-semibold text-idf-navy">Qué no hacemos</span>
					<h2 class="m-0 font-display text-[clamp(28px,3.2vw,38px)] leading-[1.14] text-idf-navy">Nada de listas de verbos para memorizar</h2>
					<p class="m-0 text-[14px] leading-[1.8] text-idf-ink/55">No damos tareas de copiar conjugaciones, no calificamos con rojo y no dejamos que una sola persona se lleve la clase hablando. Si un tema no te sirve para decir algo real, no entra al plan.</p>
					<div class="mt-2 flex flex-col gap-3">
						{notDone.map((item) => (
							<span class="flex items-start gap-3 border-b border-idf-ink/8 pb-3 text-[13px] leading-[1.6] text-idf-navy"><Check class="mt-0.5 size-4 shrink-0 text-idf-lime-deep" stroke-width={2.4} />{item}</span>
						))}
					</div>
				</div>
			</div>
		</section>

		<section class="flex w-full justify-center px-6 pb-32">
			<div class="relative flex w-full max-w-[1000px] flex-wrap items-center justify-between gap-10 overflow-hidden rounded-[32px] bg-idf-navy p-12 max-[1000px]:p-8 max-[640px]:p-6">
				<div class="relative flex max-w-[52ch] flex-col gap-3">
					<h2 class="relative m-0 font-display text-[clamp(24px,2.8vw,32px)] leading-[1.16] text-white">Pruébalo en una clase muestra</h2>
					<p class="relative m-0 text-[14px] leading-[1.75] text-white/60">Entra a una sesión real de 45 minutos y decide después. También puedes revisar los próximos inicios.</p>
				</div>
				<div class="relative flex flex-wrap gap-3">
					<a href={waHref} target="_blank" rel="noopener noreferrer" class="relative rounded-full bg-idf-lime px-7 py-3.5 text-[14px] font-medium whitespace-nowrap text-idf-navy no-underline transition-all duration-300 hover:-translate-y-px hover:bg-white">
						Agendar por WhatsApp
					</a>
					<a href={`/calendarios`} class="relative rounded-full border border-white/22 px-7 py-3.5 text-[14px] whitespace-nowrap text-white no-underline transition-colors duration-300 hover:bg-white/10">
						Ver próximos inicios
					</a>
				</div>
			</div>
		</section>

		<SiteFooter />
		<FloatingDock />
	</div>
</Layout>
