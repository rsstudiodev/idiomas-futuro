---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import FloatingDock from "@/components/FloatingDock.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { waHref } from "@/config/whatsapp";
type Row = { level: string; schedule: string; start: string; seats: string; seatStyle: "amber" | "blue" | "muted"; cta: string; href: string };

const ingles: Row[] = [
	{ level: "A1 Básico", schedule: "Lun y Mié · 19:00–21:00", start: "3 sep 2026", seats: "6 lugares", seatStyle: "amber", cta: "Apartar lugar", href: waHref },
	{ level: "A1 Básico matutino", schedule: "Mar y Jue · 7:00–9:00", start: "8 sep 2026", seats: "8 lugares", seatStyle: "blue", cta: "Apartar lugar", href: waHref },
	{ level: "A2 Elemental", schedule: "Lun y Mié · 17:00–19:00", start: "15 sep 2026", seats: "3 lugares", seatStyle: "amber", cta: "Apartar lugar", href: waHref },
	{ level: "B1 Intermedio", schedule: "Mar y Jue · 19:00–21:00", start: "22 sep 2026", seats: "5 lugares", seatStyle: "blue", cta: "Apartar lugar", href: waHref },
	{ level: "B2 Avanzado", schedule: "Sáb · 9:00–13:00", start: "3 oct 2026", seats: "Lista de espera", seatStyle: "muted", cta: "Anotarme", href: waHref },
	{ level: "C1 Dominio", schedule: "Vie · 18:00–21:00", start: "9 oct 2026", seats: "7 lugares", seatStyle: "blue", cta: "Apartar lugar", href: waHref },
];

const portugues: Row[] = [
	{ level: "A1 Iniciación", schedule: "Mar y Jue · 20:00–21:30", start: "5 sep 2026", seats: "8 lugares", seatStyle: "blue", cta: "Apartar lugar", href: waHref },
	{ level: "A2 Elemental", schedule: "Sáb · 10:00–13:00", start: "12 sep 2026", seats: "4 lugares", seatStyle: "amber", cta: "Apartar lugar", href: waHref },
	{ level: "B1 Conversacional", schedule: "Lun y Mié · 20:00–21:30", start: "28 sep 2026", seats: "6 lugares", seatStyle: "blue", cta: "Apartar lugar", href: waHref },
	{ level: "B2 Negocios", schedule: "Vie · 18:00–21:00", start: "16 oct 2026", seats: "8 lugares", seatStyle: "blue", cta: "Apartar lugar", href: waHref },
];

const chino: Row[] = [
	{ level: "HSK 1", schedule: "Mar y Jue · 18:00–20:00", start: "22 sep 2026", seats: "8 lugares", seatStyle: "blue", cta: "Apartar lugar", href: waHref },
	{ level: "HSK 2", schedule: "Sáb · 9:00–12:00", start: "10 oct 2026", seats: "5 lugares", seatStyle: "amber", cta: "Apartar lugar", href: waHref },
	{ level: "HSK 3", schedule: "Lun y Mié · 18:00–20:00", start: "2 nov 2026", seats: "6 lugares", seatStyle: "blue", cta: "Apartar lugar", href: waHref },
	{ level: "HSK 4", schedule: "Vie · 17:30–20:30", start: "Enero 2027", seats: "Próximamente", seatStyle: "muted", cta: "Avisarme", href: waHref },
];

const seatClasses: Record<Row["seatStyle"], string> = {
	amber: "text-idf-lime-deep",
	blue: "text-idf-ink/55",
	muted: "text-idf-ink/40",
};

const groups = [
	{ id: "ingles", eyebrow: "A1 – C1 · seis niveles", title: "Inglés", meta: "4 meses por nivel · 2 sesiones semanales", rows: ingles, alt: false },
	{ id: "portugues", eyebrow: "A1 – B2 · variante de Brasil", title: "Portugués", meta: "3 meses por nivel · 2 sesiones semanales", rows: portugues, alt: true },
	{ id: "chino", eyebrow: "HSK 1 – HSK 4", title: "Chino mandarín", meta: "5 meses por nivel · incluye taller de caracteres", rows: chino, alt: false },
];
---

<Layout title="Próximos inicios — Idiomas del Futuro">
	<div class="w-full overflow-x-hidden bg-idf-cream pb-24 text-idf-ink">
		<PageHero
			kicker="Ciclo septiembre – diciembre 2026"
			title="Próximos inicios"
			description="Cada grupo abre con máximo 8 personas y cierra en cuanto se llena. Aparta tu lugar con un mensaje: te confirmamos el nivel con un examen de 15 minutos."
			image="https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=2000&q=80"
			imageAlt="Mesa de trabajo con agendas y cuadernos"
			focus="55% 40%"
			focusMobile="52% 30%"
		>
			<div class="flex flex-wrap gap-x-8 gap-y-3">
				<a href="calendarios/#ingles" class="border-b border-white/25 pb-1 text-[14px] text-white/80 no-underline transition-colors duration-300 hover:border-idf-lime hover:text-idf-lime">Inglés</a>
				<a href="calendarios/#portugues" class="border-b border-white/25 pb-1 text-[14px] text-white/80 no-underline transition-colors duration-300 hover:border-idf-lime hover:text-idf-lime">Portugués</a>
				<a href="calendarios/#chino" class="border-b border-white/25 pb-1 text-[14px] text-white/80 no-underline transition-colors duration-300 hover:border-idf-lime hover:text-idf-lime">Chino mandarín</a>
			</div>
		</PageHero>

		{groups.map((g) => (
			<section id={g.id} class:list={["flex w-full scroll-mt-[120px] flex-col items-center px-6 py-24 max-[1000px]:py-20 max-[640px]:py-14", g.alt && "bg-idf-cream-alt"]}>
				<div class="mb-10 flex w-full max-w-[1000px] flex-wrap items-end justify-between gap-6">
					<div class="flex flex-col gap-2.5">
						<span class="text-[12px] font-semibold text-idf-navy">{g.eyebrow}</span>
						<h2 class="m-0 font-display text-[clamp(28px,3.4vw,40px)] text-idf-navy">{g.title}</h2>
					</div>
					<span class="text-[13px] text-idf-ink/50">{g.meta}</span>
				</div>
				<div class="flex w-full max-w-[1000px] flex-col gap-3">
					<div class="grid grid-cols-[1.1fr_1.2fr_1fr_0.8fr_150px] gap-4 px-6 pb-2 text-[10px] font-semibold tracking-[0.14em] text-idf-navy/40 uppercase max-[1000px]:hidden">
						<span>Nivel</span><span>Horario</span><span>Inicia</span><span>Cupo</span><span></span>
					</div>
					{g.rows.map((r) => (
						<div class="grid grid-cols-[1.1fr_1.2fr_1fr_0.8fr_150px] items-center gap-4 rounded-[20px] border border-idf-ink/8 bg-white px-6 py-5 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_12px_28px_rgba(12,43,25,0.10)] max-[1000px]:grid-cols-1 max-[1000px]:justify-items-start max-[1000px]:gap-2.5">
							<span class="text-[15px] font-medium text-idf-navy">{r.level}</span>
							<span class="text-[13px] text-idf-ink/55">{r.schedule}</span>
							<span class="text-[13px] text-idf-ink/55">{r.start}</span>
							<span class:list={["justify-self-start text-[12px] font-medium", seatClasses[r.seatStyle]]}>{r.seats}</span>
							<a href={r.href} target="_blank" rel="noopener noreferrer" class:list={["justify-self-end whitespace-nowrap rounded-[12px] px-5 py-2.5 text-[12px] font-medium no-underline transition-colors duration-300 max-[1000px]:justify-self-start", r.seatStyle === "muted" ? "bg-idf-ink/6 text-idf-ink/60" : "bg-idf-navy text-white hover:bg-idf-blue"]}>
								{r.cta}
							</a>
						</div>
					))}
				</div>
			</section>
		))}

		<section class="flex w-full justify-center px-6 pb-32">
			<div class="relative flex w-full max-w-[1000px] flex-wrap items-center justify-between gap-10 overflow-hidden rounded-[32px] bg-idf-navy p-12 max-[1000px]:p-8 max-[640px]:p-6">
				<div class="relative flex max-w-[52ch] flex-col gap-3">
					<h2 class="relative m-0 font-display text-[clamp(24px,2.8vw,32px)] leading-[1.16] text-white">¿No sabes qué nivel te toca?</h2>
					<p class="relative m-0 text-[14px] leading-[1.75] text-white/60">Te aplicamos un examen de ubicación de 15 minutos sin costo, presencial o en línea.</p>
				</div>
				<a href={waHref} target="_blank" rel="noopener noreferrer" class="relative rounded-full bg-idf-lime px-7 py-3.5 text-[14px] font-medium whitespace-nowrap text-idf-navy no-underline transition-all duration-300 hover:-translate-y-px hover:bg-white">
					Agendar examen gratis
				</a>
			</div>
		</section>

		<SiteFooter />
		<FloatingDock />
	</div>
</Layout>
