---
import Layout from "@/layouts/Layout.astro";
import FloatingDock from "@/components/FloatingDock.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { waHref } from "@/config/whatsapp";
const teachers = [
	{
		eyebrow: "Coordinadora académica · Inglés",
		name: "Fernanda Ortega",
		bio: "Doce años enseñando inglés, seis de ellos en Manchester dando clases a adultos migrantes. Diseña los planes de los niveles B1 a C1 y entrena a los demás profesores en corrección amable.",
		img: "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=800&q=80",
		tags: ["C2 certificado", "Formación docente", "Prep. de exámenes"],
		imageFirst: true,
	},
	{
		eyebrow: "Portugués · Conversación",
		name: "Thiago Nascimento",
		bio: "Nació en Salvador de Bahía y llegó a Guadalajara hace ocho años. Da los niveles de portugués completos y el club de conversación de los sábados; sus clases empiezan siempre con una nota de prensa del día.",
		img: "https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=800&q=80",
		tags: ["Hablante nativo", "Portugués de negocios", "Fonética"],
		imageFirst: false,
	},
	{
		eyebrow: "Chino mandarín · HSK",
		name: "Li Wen Chen",
		bio: "Originaria de Taipéi, licenciada en enseñanza de mandarín como lengua extranjera. Lleva los cuatro niveles de HSK y el taller de caracteres, donde se escribe a mano desde el primer día.",
		img: "https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=800&q=80",
		tags: ["Hablante nativa", "HSK 1–4", "Caligrafía"],
		imageFirst: true,
	},
	{
		eyebrow: "Inglés · Cursos in-company",
		name: "Kwame Mensah",
		bio: "Ghanés, ingeniero de formación y profesor por vocación. Atiende los grupos corporativos y los niveles matutinos: sus sesiones se arman con casos reales del trabajo de cada alumno.",
		img: "https://images.unsplash.com/photo-1568602471122-7832951cc4c5?auto=format&fit=crop&w=800&q=80",
		tags: ["Hablante nativo", "Inglés técnico", "Grupos de empresa"],
		imageFirst: false,
	},
];
---

<Layout title="Profesores — Idiomas del Futuro">
	<div class="w-full overflow-x-hidden bg-idf-cream pb-24 text-idf-ink">
		<section class="relative flex w-full flex-col items-center overflow-hidden rounded-b-[40px] bg-idf-navy px-6 pt-[148px] pb-32 text-center max-[640px]:pt-[108px] max-[640px]:pb-24">
			<div class="absolute inset-0 bg-[radial-gradient(130%_110%_at_18%_-15%,#1b5c33_0%,#10391f_42%,#0a2415_72%,#061309_100%)]"></div>
			<div class="relative flex max-w-[820px] flex-col items-center gap-7">
				<div class="relative flex h-14 w-14 items-center justify-center rounded-[18px] bg-idf-lime">
					<span class="block h-5.5 w-5.5 rounded-full border-[3px] border-idf-navy"></span>
					<span class="absolute top-2.5 right-2.5 h-2.5 w-2.5 rotate-45 bg-idf-navy"></span>
				</div>
				<span class="text-[11px] font-medium tracking-[0.16em] text-idf-lime uppercase">Equipo docente</span>
				<h1 class="m-0 text-balance font-display text-[clamp(34px,4.6vw,60px)] leading-[1.02] tracking-[-0.035em] text-white">Quién te va a enseñar</h1>
				<p class="m-0 max-w-[56ch] text-[16px] leading-[1.7] text-white/75">
					Cuatro profesores de planta, todos certificados y con años viviendo en el idioma que enseñan. Nadie improvisa una clase aquí.
				</p>
			</div>
		</section>

		<section class="flex w-full flex-col items-center gap-6 px-6 pt-20 pb-28">
			{teachers.map((t) => (
				<div class:list={["grid w-full max-w-[1000px] items-center gap-10 rounded-[28px] border border-idf-ink/8 bg-white p-8 max-[1000px]:grid-cols-1 max-[1000px]:p-6", t.imageFirst ? "grid-cols-[340px_1fr]" : "grid-cols-[1fr_340px]"]}>
					<div class:list={["aspect-4/5 overflow-hidden rounded-[22px] max-[1000px]:order-1", !t.imageFirst && "order-2"]}>
						<img src={t.img} alt={t.name} class="block h-full w-full object-cover" />
					</div>
					<div class:list={["flex flex-col gap-4.5", !t.imageFirst && "order-1"]}>
						<span class="text-[12px] font-semibold text-idf-navy">{t.eyebrow}</span>
						<h2 class="m-0 font-display text-[30px] text-idf-navy">{t.name}</h2>
						<p class="m-0 text-[14px] leading-[1.8] text-idf-ink/55">{t.bio}</p>
						<p class="m-0 text-[12px] font-medium tracking-[0.02em] text-idf-navy/50">{t.tags.join(" · ")}</p>
					</div>
				</div>
			))}
		</section>

		<section class="flex w-full justify-center px-6 pb-32">
			<div class="relative flex w-full max-w-[1000px] flex-wrap items-center justify-between gap-10 overflow-hidden rounded-[32px] bg-idf-navy p-12 max-[1000px]:p-8 max-[640px]:p-6">
				<div class="relative flex max-w-[52ch] flex-col gap-3">
					<h2 class="relative m-0 font-display text-[clamp(24px,2.8vw,32px)] leading-[1.16] text-white">Conoce a tu profesor antes de inscribirte</h2>
					<p class="relative m-0 text-[14px] leading-[1.75] text-white/60">Puedes tomar una clase muestra de 45 minutos con el grupo que te interesa, sin compromiso.</p>
				</div>
				<a href={waHref} target="_blank" rel="noopener noreferrer" class="relative rounded-full bg-idf-lime px-7 py-3.5 text-[14px] font-medium whitespace-nowrap text-idf-navy no-underline transition-all duration-300 hover:-translate-y-px hover:bg-white">
					Agendar clase muestra
				</a>
			</div>
		</section>

		<SiteFooter />
		<FloatingDock />
	</div>
</Layout>
