---
import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import WhatsAppFab from "@/components/WhatsAppFab.astro";
import { buildStaticPaths } from "astro-react-i18next/utils";

export function getStaticPaths() {
	return buildStaticPaths();
}

type Row = { level: string; schedule: string; start: string; seats: string; seatStyle: "amber" | "blue" | "muted"; cta: string; href: string };

const ingles: Row[] = [
	{ level: "A1 Básico", schedule: "Lun y Mié · 19:00–21:00", start: "3 sep 2026", seats: "6 lugares", seatStyle: "amber", cta: "Apartar lugar", href: "https://wa.me/523311223344?text=Quiero%20apartar%20Ingl%C3%A9s%20A1%20del%203%20de%20septiembre" },
	{ level: "A1 Básico matutino", schedule: "Mar y Jue · 7:00–9:00", start: "8 sep 2026", seats: "8 lugares", seatStyle: "blue", cta: "Apartar lugar", href: "https://wa.me/523311223344?text=Quiero%20apartar%20Ingl%C3%A9s%20A1%20matutino" },
	{ level: "A2 Elemental", schedule: "Lun y Mié · 17:00–19:00", start: "15 sep 2026", seats: "3 lugares", seatStyle: "amber", cta: "Apartar lugar", href: "https://wa.me/523311223344?text=Quiero%20apartar%20Ingl%C3%A9s%20A2" },
	{ level: "B1 Intermedio", schedule: "Mar y Jue · 19:00–21:00", start: "22 sep 2026", seats: "5 lugares", seatStyle: "blue", cta: "Apartar lugar", href: "https://wa.me/523311223344?text=Quiero%20apartar%20Ingl%C3%A9s%20B1" },
	{ level: "B2 Avanzado", schedule: "Sáb · 9:00–13:00", start: "3 oct 2026", seats: "Lista de espera", seatStyle: "muted", cta: "Anotarme", href: "https://wa.me/523311223344?text=Quiero%20entrar%20a%20la%20lista%20de%20espera%20de%20Ingl%C3%A9s%20B2" },
	{ level: "C1 Dominio", schedule: "Vie · 18:00–21:00", start: "9 oct 2026", seats: "7 lugares", seatStyle: "blue", cta: "Apartar lugar", href: "https://wa.me/523311223344?text=Quiero%20apartar%20Ingl%C3%A9s%20C1" },
];

const portugues: Row[] = [
	{ level: "A1 Iniciación", schedule: "Mar y Jue · 20:00–21:30", start: "5 sep 2026", seats: "8 lugares", seatStyle: "blue", cta: "Apartar lugar", href: "https://wa.me/523311223344?text=Quiero%20apartar%20Portugu%C3%A9s%20A1" },
	{ level: "A2 Elemental", schedule: "Sáb · 10:00–13:00", start: "12 sep 2026", seats: "4 lugares", seatStyle: "amber", cta: "Apartar lugar", href: "https://wa.me/523311223344?text=Quiero%20apartar%20Portugu%C3%A9s%20A2" },
	{ level: "B1 Conversacional", schedule: "Lun y Mié · 20:00–21:30", start: "28 sep 2026", seats: "6 lugares", seatStyle: "blue", cta: "Apartar lugar", href: "https://wa.me/523311223344?text=Quiero%20apartar%20Portugu%C3%A9s%20B1" },
	{ level: "B2 Negocios", schedule: "Vie · 18:00–21:00", start: "16 oct 2026", seats: "8 lugares", seatStyle: "blue", cta: "Apartar lugar", href: "https://wa.me/523311223344?text=Quiero%20apartar%20Portugu%C3%A9s%20B2" },
];

const chino: Row[] = [
	{ level: "HSK 1", schedule: "Mar y Jue · 18:00–20:00", start: "22 sep 2026", seats: "8 lugares", seatStyle: "blue", cta: "Apartar lugar", href: "https://wa.me/523311223344?text=Quiero%20apartar%20Chino%20HSK%201" },
	{ level: "HSK 2", schedule: "Sáb · 9:00–12:00", start: "10 oct 2026", seats: "5 lugares", seatStyle: "amber", cta: "Apartar lugar", href: "https://wa.me/523311223344?text=Quiero%20apartar%20Chino%20HSK%202" },
	{ level: "HSK 3", schedule: "Lun y Mié · 18:00–20:00", start: "2 nov 2026", seats: "6 lugares", seatStyle: "blue", cta: "Apartar lugar", href: "https://wa.me/523311223344?text=Quiero%20apartar%20Chino%20HSK%203" },
	{ level: "HSK 4", schedule: "Vie · 17:30–20:30", start: "Enero 2027", seats: "Próximamente", seatStyle: "muted", cta: "Avisarme", href: "https://wa.me/523311223344?text=Av%C3%ADsenme%20cuando%20abra%20HSK%204" },
];

const seatClasses: Record<Row["seatStyle"], string> = {
	amber: "bg-idf-amber/22 text-[#8a5a17]",
	blue: "bg-idf-blue/10 text-idf-navy",
	muted: "bg-idf-ink/8 text-idf-ink/55",
};

const groups = [
	{ id: "ingles", eyebrow: "A1 – C1 · seis niveles", title: "Inglés", meta: "4 meses por nivel · 2 sesiones semanales", rows: ingles, alt: false },
	{ id: "portugues", eyebrow: "A1 – B2 · variante de Brasil", title: "Portugués", meta: "3 meses por nivel · 2 sesiones semanales", rows: portugues, alt: true },
	{ id: "chino", eyebrow: "HSK 1 – HSK 4", title: "Chino mandarín", meta: "5 meses por nivel · incluye taller de caracteres", rows: chino, alt: false },
];
---

<Layout title="Próximos inicios — Idiomas del Futuro">
	<div class="w-full overflow-x-hidden bg-idf-cream text-idf-ink">
		<SiteHeader />

		<section class="relative flex w-full flex-col items-center overflow-hidden px-6 pt-[200px] pb-24 text-center max-[640px]:pt-[130px]">
			<div class="absolute inset-0 bg-[radial-gradient(110%_80%_at_50%_-20%,#c5d8f0_0%,#dfe9f4_34%,#f1efe6_64%,#faf6ec_88%)]"></div>
			<div class="relative flex max-w-[820px] flex-col items-center gap-6">
				<span class="rounded-full border border-idf-navy/12 bg-idf-cream-light/80 px-4.5 py-2 font-sans text-xs tracking-[0.16em] text-idf-navy uppercase">Ciclo septiembre – diciembre 2026</span>
				<div class="mb-2 flex flex-col items-center gap-4">
					<div class="relative flex h-15.5 w-15.5 items-center justify-center rounded-[19px] bg-idf-navy">
						<span class="block h-6 w-6 rounded-full border-3 border-idf-cream"></span>
						<span class="absolute top-2.5 right-2.5 h-3 w-3 rotate-45 bg-idf-amber"></span>
					</div>
					<span class="font-sans text-[11px] tracking-[0.3em] text-idf-navy/60 uppercase">Idiomas del Futuro</span>
				</div>
				<h1 class="m-0 font-display text-[clamp(40px,5.4vw,74px)] leading-[1.05] tracking-tight text-idf-navy">Próximos inicios</h1>
				<p class="m-0 max-w-[56ch] font-sans text-[17px] leading-loose text-idf-ink/66">
					Cada grupo abre con máximo 8 personas y cierra en cuanto se llena. Aparta tu lugar con un mensaje: te confirmamos el nivel con un examen de 15 minutos.
				</p>
				<div class="mt-2 flex flex-wrap justify-center gap-3">
					<a href="#ingles" class="rounded-full border border-idf-navy/14 bg-idf-cream-light px-5.5 py-3 font-sans text-sm text-idf-navy no-underline hover:border-idf-navy/30">Inglés</a>
					<a href="#portugues" class="rounded-full border border-idf-navy/14 bg-idf-cream-light px-5.5 py-3 font-sans text-sm text-idf-navy no-underline hover:border-idf-navy/30">Portugués</a>
					<a href="#chino" class="rounded-full border border-idf-navy/14 bg-idf-cream-light px-5.5 py-3 font-sans text-sm text-idf-navy no-underline hover:border-idf-navy/30">Chino mandarín</a>
				</div>
			</div>
		</section>

		{groups.map((g) => (
			<section id={g.id} class:list={["flex w-full scroll-mt-[120px] flex-col items-center px-6 py-28 max-[1000px]:py-22 max-[640px]:py-16", g.alt && "bg-idf-cream-alt"]}>
				<div class="mb-10 flex w-full max-w-[1000px] flex-wrap items-end justify-between gap-6">
					<div class="flex flex-col gap-2.5">
						<span class="font-sans text-[11px] tracking-[0.16em] text-idf-navy/55 uppercase">{g.eyebrow}</span>
						<h2 class="m-0 font-display text-4xl tracking-tight text-idf-navy">{g.title}</h2>
					</div>
					<span class="font-sans text-sm text-idf-ink/60">{g.meta}</span>
				</div>
				<div class="flex w-full max-w-[1000px] flex-col gap-3">
					<div class="grid grid-cols-[1.1fr_1.2fr_1fr_0.8fr_150px] gap-4 px-7 pb-3 font-sans text-[11px] tracking-[0.14em] text-idf-navy/50 uppercase max-[1000px]:hidden">
						<span>Nivel</span><span>Horario</span><span>Inicia</span><span>Cupo</span><span></span>
					</div>
					{g.rows.map((r) => (
						<div class="grid grid-cols-[1.1fr_1.2fr_1fr_0.8fr_150px] items-center gap-4 rounded-3xl border border-idf-navy/12 bg-idf-cream-light px-7 py-6 shadow-sm transition-all duration-300 hover:border-idf-navy/28 hover:shadow-[0_10px_26px_rgba(20,52,92,0.08)] max-[1000px]:grid-cols-1 max-[1000px]:justify-items-start max-[1000px]:gap-2.5">
							<span class="font-sans text-[17px] text-idf-navy">{r.level}</span>
							<span class="font-sans text-sm text-idf-ink/66">{r.schedule}</span>
							<span class="font-sans text-sm text-idf-ink/66">{r.start}</span>
							<span class:list={["justify-self-start rounded-full px-3 py-1.5 font-sans text-xs", seatClasses[r.seatStyle]]}>{r.seats}</span>
							<a href={r.href} target="_blank" rel="noopener noreferrer" class:list={["justify-self-end whitespace-nowrap rounded-full px-5 py-2.75 font-sans text-[13px] no-underline max-[1000px]:justify-self-start", r.seatStyle === "muted" ? "bg-idf-navy/8 text-idf-navy" : "bg-idf-whatsapp font-semibold text-idf-whatsapp-ink"]}>
								{r.cta}
							</a>
						</div>
					))}
				</div>
			</section>
		))}

		<section class="flex w-full justify-center px-6 pb-32">
			<div class="flex w-full max-w-[1000px] flex-wrap items-center justify-between gap-10 rounded-[40px] bg-idf-navy p-14 max-[1000px]:p-8 max-[640px]:p-6">
				<div class="flex max-w-[52ch] flex-col gap-3">
					<h2 class="m-0 font-display text-[34px] leading-tight text-idf-cream">¿No sabes qué nivel te toca?</h2>
					<p class="m-0 font-sans text-[15px] leading-loose text-idf-cream/72">Te aplicamos un examen de ubicación de 15 minutos sin costo, presencial o en línea.</p>
				</div>
				<a href="https://wa.me/523311223344?text=Quiero%20mi%20examen%20de%20ubicaci%C3%B3n" target="_blank" rel="noopener noreferrer" class="rounded-full bg-idf-whatsapp px-7.5 py-4 font-sans text-base font-semibold whitespace-nowrap text-idf-whatsapp-ink no-underline transition-all duration-300 hover:-translate-y-px hover:shadow-[0_12px_30px_rgba(37,211,102,0.35)]">
					Agendar examen gratis
				</a>
			</div>
		</section>

		<SiteFooter />
		<WhatsAppFab />
	</div>
</Layout>
